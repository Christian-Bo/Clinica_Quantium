<div class="rounded-control bg-surface-muted px-3 py-2">
    <p class="text-[10px] font-semibold uppercase tracking-wide text-ink-muted">@Etiqueta</p>
    <p class="mt-0.5 text-sm font-semibold text-ink">
        @Valor
        @if (!string.IsNullOrWhiteSpace(Unidad))
        {
            <span class="text-xs font-normal text-ink-muted">@Unidad</span>
        }
    </p>
</div>

@code {
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Valor { get; set; } = string.Empty;
    [Parameter] public string Unidad { get; set; } = string.Empty;
}
