@inject AuthApiService AuthApi
@inject ToastService Toasts

<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged"
       Title="@(paso == Paso.PedirCodigo ? "Recuperar contraseña" : "Escribe tu código")"
       IconName="lock" MaxWidthClass="max-w-md" CloseOnBackdrop="false">
    <Body>
        @if (paso == Paso.PedirCodigo)
        {
            <p class="text-sm leading-relaxed text-ink-muted">
                Escribe el correo con el que te registraste. Te enviaremos un código para elegir una contraseña nueva.
            </p>
            <ValidatedTextInput Id="rp-email" Label="Correo electrónico" Required="true" Kind="FormFieldKind.Email"
                                Value="@email" ValueChanged="v => email = v" Placeholder="Ej. usuario@dominio.com"
                                Autocomplete="email" MaxLength="254" HelperText="Usa exactamente el correo asociado a tu cuenta."
                                ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" CssClass="mt-4" />
        }
        else
        {
            <div class="flex items-start gap-2.5 rounded-control border border-brand-200 bg-brand-50 px-3.5 py-3">
                <span class="mt-0.5 text-brand-600"><Icon Name="mail" Size="17" /></span>
                <p class="text-sm leading-relaxed text-ink-muted">
                    Si <strong class="font-medium text-ink">@email</strong> está registrado, ahí llegó el código. Revisa también correo no deseado.
                </p>
            </div>

            <div class="mt-4 space-y-4">
                <ValidatedTextArea Id="rp-codigo" Label="Código del correo" Required="true" Value="@codigo" ValueChanged="v => codigo = v"
                                   Placeholder="Pega aquí el código completo recibido por correo" HelperText="Cópialo completo y evita espacios al inicio o al final."
                                   MinLength="1" MaxLength="2000" Rows="3" ShowCounter="false"
                                   ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <PasswordField Id="rp-nueva" Label="Contraseña nueva" Value="@passwordNueva" ValueChanged="v => passwordNueva = v"
                               Placeholder="Ej. Nueva@2026" ShowRules="true" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <PasswordField Id="rp-confirmacion" Label="Repetir contraseña nueva" Value="@passwordConfirmacion" ValueChanged="v => passwordConfirmacion = v"
                               ValidatePolicy="false" ValidateMatch="true" MatchValue="@passwordNueva"
                               Placeholder="Repite la contraseña nueva" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
            </div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div role="alert" class="mt-4 flex items-start gap-2.5 rounded-control border border-state-rechazada/25 bg-state-rechazada/10 px-3.5 py-3">
                <span class="mt-0.5 text-state-rechazada"><Icon Name="alert-triangle" Size="17" /></span>
                <p class="text-sm leading-relaxed text-state-rechazada">@error</p>
            </div>
        }
    </Body>
    <Footer>
        @if (paso == Paso.CanjearCodigo)
        {
            <Button Variant="ButtonVariant.Ghost" Disabled="trabajando" OnClick="VolverPaso">Atrás</Button>
        }
        <Button Variant="ButtonVariant.Secondary" Disabled="trabajando" OnClick="Cerrar">Cancelar</Button>
        <Button Variant="ButtonVariant.Primary" Loading="trabajando" OnClick="Continuar">
            @(paso == Paso.PedirCodigo ? "Enviarme el código" : "Cambiar contraseña")
        </Button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string EmailInicial { get; set; } = string.Empty;

    private enum Paso { PedirCodigo, CanjearCodigo }
    private Paso paso = Paso.PedirCodigo;
    private string email = string.Empty;
    private string codigo = string.Empty;
    private string passwordNueva = string.Empty;
    private string passwordConfirmacion = string.Empty;
    private string? error;
    private bool trabajando;
    private bool isOpenAnterior;
    private bool mostrarValidaciones;
    private int cicloValidacion;

    protected override void OnParametersSet()
    {
        if (IsOpen && !isOpenAnterior)
        {
            paso = Paso.PedirCodigo;
            email = FormValidation.NormalizeEmail(EmailInicial);
            codigo = passwordNueva = passwordConfirmacion = string.Empty;
            error = null;
            mostrarValidaciones = false;
            cicloValidacion++;
        }
        isOpenAnterior = IsOpen;
    }

    private Task Continuar() => paso == Paso.PedirCodigo ? EnviarCodigo() : CambiarPassword();

    private async Task EnviarCodigo()
    {
        error = null;
        mostrarValidaciones = true;
        if (!FormValidation.IsEmailValid(email)) return;
        trabajando = true;
        try
        {
            var resultado = await AuthApi.SolicitarCodigoRecuperacionAsync(FormValidation.NormalizeEmail(email));
            if (resultado.Exito)
            {
                paso = Paso.CanjearCodigo;
                mostrarValidaciones = false;
                cicloValidacion++;
                return;
            }
            error = resultado.Error;
        }
        finally { trabajando = false; }
    }

    private async Task CambiarPassword()
    {
        error = null;
        mostrarValidaciones = true;
        if (string.IsNullOrWhiteSpace(codigo) || !FormValidation.IsPasswordValid(passwordNueva)
            || !string.Equals(passwordNueva, passwordConfirmacion, StringComparison.Ordinal)) return;

        trabajando = true;
        try
        {
            var resultado = await AuthApi.RestablecerPasswordAsync(FormValidation.NormalizeEmail(email), codigo.Trim(), passwordNueva);
            if (resultado.Exito)
            {
                Toasts.Exito("Tu contraseña quedó cambiada. Ya puedes ingresar con ella.");
                await Cerrar();
                return;
            }
            error = resultado.Error;
        }
        finally { trabajando = false; }
    }

    private void VolverPaso()
    {
        paso = Paso.PedirCodigo;
        mostrarValidaciones = false;
        cicloValidacion++;
        error = null;
    }

    private async Task Cerrar()
    {
        error = null;
        await IsOpenChanged.InvokeAsync(false);
    }
}
