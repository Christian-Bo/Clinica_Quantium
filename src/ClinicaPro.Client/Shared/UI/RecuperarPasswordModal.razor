@inject AuthApiService AuthApi
@inject ToastService Toasts

@* Recuperación de contraseña en dos pasos, contra los endpoints reales de la
   API: forgot-password envía un código al correo, reset-password lo canjea.
   No se navega a otra página para no perder el correo ya escrito. *@

<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged"
       Title="@(paso == Paso.PedirCodigo ? "Recuperar contraseña" : "Escribe tu código")"
       IconName="lock" MaxWidthClass="max-w-md">
    <Body>
        @if (paso == Paso.PedirCodigo)
        {
            <p class="text-sm leading-relaxed text-ink-muted">
                Escribe el correo con el que te registraste. Te enviamos un código para que puedas
                elegir una contraseña nueva.
            </p>

            <div class="mt-4">
                <label class="text-sm font-medium text-ink" for="rp-email">Correo electrónico</label>
                <input id="rp-email" type="email" autocomplete="email" class="@ClaseInput"
                       placeholder="tucorreo@ejemplo.com"
                       @bind="email" @bind:event="oninput" />
            </div>
        }
        else
        {
            <div class="flex items-start gap-2.5 rounded-control border border-brand-200 bg-brand-50 px-3.5 py-3">
                <span class="mt-0.5 text-brand-600"><Icon Name="mail" Size="17" /></span>
                <p class="text-sm leading-relaxed text-ink-muted">
                    Si <strong class="font-medium text-ink">@email</strong> está registrado, ahí llegó el código.
                    Revisa también la carpeta de correo no deseado.
                </p>
            </div>

            <div class="mt-4 space-y-4">
                <div>
                    <label class="text-sm font-medium text-ink" for="rp-codigo">Código del correo</label>
                    <textarea id="rp-codigo" rows="3" class="@ClaseInput font-mono text-xs"
                              placeholder="Pega aquí el código completo"
                              @bind="codigo" @bind:event="oninput"></textarea>
                    <p class="mt-1 text-xs text-ink-muted">Es largo: cópialo y pégalo completo, sin espacios de más.</p>
                </div>

                <div>
                    <label class="text-sm font-medium text-ink" for="rp-nueva">Contraseña nueva</label>
                    <input id="rp-nueva" type="password" autocomplete="new-password" class="@ClaseInput"
                           @bind="passwordNueva" @bind:event="oninput" />
                    <p class="mt-1 text-xs text-ink-muted">@AyudaPassword</p>
                </div>

                <div>
                    <label class="text-sm font-medium text-ink" for="rp-confirmacion">Repetir contraseña nueva</label>
                    <input id="rp-confirmacion" type="password" autocomplete="new-password" class="@ClaseInput"
                           @bind="passwordConfirmacion" @bind:event="oninput" />
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div role="alert" class="mt-4 flex items-start gap-2.5 rounded-control border border-state-rechazada/25 bg-state-rechazada/10 px-3.5 py-3">
                <span class="mt-0.5 text-state-rechazada"><Icon Name="alert-triangle" Size="17" /></span>
                <p class="text-sm leading-relaxed text-state-rechazada">@error</p>
            </div>
        }
    </Body>
    <Footer>
        @if (paso == Paso.CanjearCodigo)
        {
            <Button Variant="ButtonVariant.Ghost" OnClick="() => paso = Paso.PedirCodigo">Atrás</Button>
        }
        <Button Variant="ButtonVariant.Secondary" OnClick="Cerrar">Cancelar</Button>
        <Button Variant="ButtonVariant.Primary" Loading="trabajando" OnClick="Continuar">
            @(paso == Paso.PedirCodigo ? "Enviarme el código" : "Cambiar contraseña")
        </Button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Correo ya escrito en el login, para no pedirlo dos veces.</summary>
    [Parameter] public string EmailInicial { get; set; } = string.Empty;

    private enum Paso { PedirCodigo, CanjearCodigo }

    private const string ClaseInput =
        "mt-1.5 w-full rounded-control border border-border bg-surface px-3 py-2.5 text-sm text-ink " +
        "placeholder:text-ink-muted/60 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100";

    private static readonly string AyudaPassword =
        $"Mínimo {ModeloDatosPaciente.PasswordMinLength} caracteres, con mayúscula, minúscula, número y un símbolo.";

    private Paso paso = Paso.PedirCodigo;
    private string email = string.Empty;
    private string codigo = string.Empty;
    private string passwordNueva = string.Empty;
    private string passwordConfirmacion = string.Empty;
    private string? error;
    private bool trabajando;
    private bool isOpenAnterior;

    protected override void OnParametersSet()
    {
        if (IsOpen && !isOpenAnterior)
        {
            paso = Paso.PedirCodigo;
            email = EmailInicial;
            codigo = string.Empty;
            passwordNueva = string.Empty;
            passwordConfirmacion = string.Empty;
            error = null;
        }

        isOpenAnterior = IsOpen;
    }

    private Task Continuar() => paso == Paso.PedirCodigo ? EnviarCodigo() : CambiarPassword();

    private async Task EnviarCodigo()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Escribe tu correo electrónico.";
            return;
        }

        trabajando = true;
        var resultado = await AuthApi.SolicitarCodigoRecuperacionAsync(email);
        trabajando = false;

        if (resultado.Exito)
        {
            paso = Paso.CanjearCodigo;
            return;
        }

        error = resultado.Error;
    }

    private async Task CambiarPassword()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(codigo))
        {
            error = "Pega el código que te llegó al correo.";
            return;
        }

        var faltantes = ModeloDatosPaciente.ReglasPasswordFaltantes(passwordNueva);
        if (faltantes.Count > 0)
        {
            error = "La contraseña nueva necesita " + string.Join(", ", faltantes) + ".";
            return;
        }

        if (passwordNueva != passwordConfirmacion)
        {
            error = "Las contraseñas nuevas no coinciden.";
            return;
        }

        trabajando = true;
        var resultado = await AuthApi.RestablecerPasswordAsync(email, codigo, passwordNueva);
        trabajando = false;

        if (resultado.Exito)
        {
            Toasts.Exito("Tu contraseña quedó cambiada. Ya puedes ingresar con ella.");
            await Cerrar();
            return;
        }

        error = resultado.Error;
    }

    private async Task Cerrar()
    {
        error = null;
        await IsOpenChanged.InvokeAsync(false);
    }
}
