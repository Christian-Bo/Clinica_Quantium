@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" @onclick="ManejarBackdrop">
        <div role="dialog" aria-modal="true" aria-label="@Title"
             class="flex max-h-[90vh] w-full @MaxWidthClass flex-col rounded-card bg-surface shadow-modal"
             @onclick:stopPropagation="true">

            <div class="flex items-center justify-between border-b border-border px-5 py-4">
                <div class="flex items-center gap-2">
                    @if (!string.IsNullOrEmpty(IconName))
                    {
                        <Icon Name="@IconName" Size="18" CssClass="text-brand-600" />
                    }
                    <h2 class="text-base font-semibold text-ink">@Title</h2>
                </div>
                <button type="button" class="rounded-control p-1 text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
                        @onclick="Cerrar" aria-label="Cerrar">
                    <Icon Name="x" Size="20" />
                </button>
            </div>

            <div class="flex-1 overflow-y-auto px-5 py-4">
                @Body
            </div>

            @if (Footer is not null)
            {
                <div class="flex justify-end gap-2 border-t border-border px-5 py-3.5">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string MaxWidthClass { get; set; } = "max-w-md";
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private async Task Cerrar() => await IsOpenChanged.InvokeAsync(false);

    private async Task ManejarBackdrop()
    {
        if (CloseOnBackdrop)
        {
            await Cerrar();
        }
    }
}
