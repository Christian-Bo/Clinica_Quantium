@using ClinicaPro.Client.Features.Secretaria.Models
@inject CitasApiService CitasApi
@inject ToastService Toasts

<section class="rounded-card border border-border bg-surface p-4" aria-labelledby="preconsulta-titulo">
    <div class="flex items-center justify-between gap-3">
        <div>
            <p id="preconsulta-titulo" class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">Preconsulta</p>
            @if (preconsulta is not null && !editando)
            {
                <p class="mt-0.5 text-xs text-ink-muted">Último registro: @preconsulta.FechaRegistroUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            }
        </div>
        @if (Editable && !cargando && !editando)
        {
            <Button Variant="ButtonVariant.Ghost" Size="sm" IconName="edit" OnClick="IniciarEdicion">
                @(preconsulta is null ? "Registrar" : "Editar")
            </Button>
        }
    </div>

    @if (cargando)
    {
        <div class="mt-3"><Skeleton Filas="2" HeightClass="h-8" /></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="mt-3 flex items-center justify-between gap-3 rounded-control bg-state-rechazada/5 px-3 py-2">
            <p class="text-xs text-state-rechazada">@errorCarga</p>
            <button type="button" class="shrink-0 text-xs font-semibold text-brand-600 hover:text-brand-700" @onclick="CargarAsync">Reintentar</button>
        </div>
    }
    else if (editando)
    {
        <div class="mt-4 space-y-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div>
                    <label class="text-xs font-medium text-ink" for="pre-sis">Sistólica</label>
                    <div class="relative mt-1">
                        <input id="pre-sis" type="number" min="60" max="250" inputmode="numeric" placeholder="120"
                               class="@ClaseNumero(ErrorSistolica)" value="@sistolica" @oninput="CambiarSistolica" />
                        <span class="pointer-events-none absolute right-2 top-2.5 text-[10px] text-ink-muted">mmHg</span>
                    </div>
                    @if (mostrarErrores && ErrorSistolica is not null) { <p class="mt-1 text-[11px] text-state-rechazada">@ErrorSistolica</p> }
                </div>
                <div>
                    <label class="text-xs font-medium text-ink" for="pre-dia">Diastólica</label>
                    <div class="relative mt-1">
                        <input id="pre-dia" type="number" min="40" max="150" inputmode="numeric" placeholder="80"
                               class="@ClaseNumero(ErrorDiastolica)" value="@diastolica" @oninput="CambiarDiastolica" />
                        <span class="pointer-events-none absolute right-2 top-2.5 text-[10px] text-ink-muted">mmHg</span>
                    </div>
                    @if (mostrarErrores && ErrorDiastolica is not null) { <p class="mt-1 text-[11px] text-state-rechazada">@ErrorDiastolica</p> }
                </div>
                <div>
                    <label class="text-xs font-medium text-ink" for="pre-temp">Temperatura</label>
                    <div class="relative mt-1">
                        <input id="pre-temp" type="number" min="30" max="45" step="0.1" inputmode="decimal" placeholder="36.7"
                               class="@ClaseNumero(ErrorTemperatura)" value="@TextoDecimal(temperatura)" @oninput="CambiarTemperatura" />
                        <span class="pointer-events-none absolute right-2 top-2.5 text-[10px] text-ink-muted">°C</span>
                    </div>
                    @if (mostrarErrores && ErrorTemperatura is not null) { <p class="mt-1 text-[11px] text-state-rechazada">@ErrorTemperatura</p> }
                </div>
                <div>
                    <label class="text-xs font-medium text-ink" for="pre-oxi">Oxígeno</label>
                    <div class="relative mt-1">
                        <input id="pre-oxi" type="number" min="50" max="100" step="0.1" inputmode="decimal" placeholder="98"
                               class="@ClaseNumero(ErrorOxigeno)" value="@TextoDecimal(oxigeno)" @oninput="CambiarOxigeno" />
                        <span class="pointer-events-none absolute right-2 top-2.5 text-[10px] text-ink-muted">%</span>
                    </div>
                    @if (mostrarErrores && ErrorOxigeno is not null) { <p class="mt-1 text-[11px] text-state-rechazada">@ErrorOxigeno</p> }
                </div>
            </div>

            @if (mostrarErrores && ErrorPresionRelacional is not null)
            {
                <p class="rounded-control bg-state-rechazada/5 px-3 py-2 text-xs text-state-rechazada">@ErrorPresionRelacional</p>
            }

            <ValidatedTextArea Id="pre-observacion" Label="Observaciones" Value="@observacion" ValueChanged="v => observacion = v"
                               Placeholder="Ej. Paciente refiere mareo leve desde esta mañana."
                               HelperText="Opcional. Registra únicamente información útil para la atención."
                               MaxLength="1000" Rows="2" ShowCounter="true" />

            @if (!string.IsNullOrWhiteSpace(errorGuardado))
            {
                <p class="rounded-control bg-state-rechazada/5 px-3 py-2 text-xs text-state-rechazada">@errorGuardado</p>
            }

            <div class="flex justify-end gap-2">
                <Button Variant="ButtonVariant.Ghost" Size="sm" Disabled="guardando" OnClick="CancelarEdicion">Cancelar</Button>
                <Button Variant="ButtonVariant.Primary" Size="sm" IconName="check" Loading="guardando" Disabled="guardando" OnClick="GuardarAsync">Guardar preconsulta</Button>
            </div>
        </div>
    }
    else if (preconsulta is null)
    {
        <p class="mt-3 text-sm text-ink-muted">Aún no hay signos vitales registrados para esta cita.</p>
    }
    else
    {
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
            <Dato Etiqueta="Presión" Valor="@($"{preconsulta.PresionSistolicaMmHg}/{preconsulta.PresionDiastolicaMmHg}")" Unidad="mmHg" />
            <Dato Etiqueta="Temperatura" Valor="@preconsulta.TemperaturaCelsius.ToString("0.0")" Unidad="°C" />
            <Dato Etiqueta="Oxígeno" Valor="@preconsulta.OxigenoSangrePorcentaje.ToString("0.#")" Unidad="%" />
        </div>
        @if (!string.IsNullOrWhiteSpace(preconsulta.Observacion))
        {
            <p class="mt-3 rounded-control bg-surface-muted px-3 py-2 text-xs leading-5 text-ink-muted"><span class="font-semibold text-ink">Observación:</span> @preconsulta.Observacion</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid CitaId { get; set; }
    [Parameter] public bool Editable { get; set; }

    private PreconsultaClientDto? preconsulta;
    private Guid citaCargada;
    private bool cargando;
    private bool editando;
    private bool guardando;
    private bool mostrarErrores;
    private string? errorCarga;
    private string? errorGuardado;
    private short? sistolica;
    private short? diastolica;
    private decimal? temperatura;
    private decimal? oxigeno;
    private string observacion = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (CitaId != Guid.Empty && CitaId != citaCargada)
        {
            citaCargada = CitaId;
            editando = false;
            await CargarAsync();
        }
    }

    private async Task CargarAsync()
    {
        cargando = true;
        errorCarga = null;
        try
        {
            var resultado = await CitasApi.ObtenerPreconsultaAsync(CitaId);
            if (resultado.Exito)
            {
                preconsulta = resultado.Valor;
            }
            else if (resultado.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                preconsulta = null;
            }
            else
            {
                errorCarga = resultado.Error ?? "No fue posible cargar la preconsulta.";
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private void IniciarEdicion()
    {
        sistolica = preconsulta?.PresionSistolicaMmHg;
        diastolica = preconsulta?.PresionDiastolicaMmHg;
        temperatura = preconsulta?.TemperaturaCelsius;
        oxigeno = preconsulta?.OxigenoSangrePorcentaje;
        observacion = preconsulta?.Observacion ?? string.Empty;
        mostrarErrores = false;
        errorGuardado = null;
        editando = true;
    }

    private void CancelarEdicion()
    {
        editando = false;
        mostrarErrores = false;
        errorGuardado = null;
    }

    private string? ErrorSistolica => sistolica is null ? "Ingresa la presión sistólica." : sistolica is < 60 or > 250 ? "Debe estar entre 60 y 250." : null;
    private string? ErrorDiastolica => diastolica is null ? "Ingresa la presión diastólica." : diastolica is < 40 or > 150 ? "Debe estar entre 40 y 150." : null;
    private string? ErrorTemperatura => temperatura is null ? "Ingresa la temperatura." : temperatura is < 30 or > 45 ? "Debe estar entre 30 y 45 °C." : null;
    private string? ErrorOxigeno => oxigeno is null ? "Ingresa la saturación." : oxigeno is < 50 or > 100 ? "Debe estar entre 50 y 100 %." : null;
    private string? ErrorPresionRelacional => sistolica is not null && diastolica is not null && diastolica >= sistolica ? "La presión diastólica debe ser menor que la sistólica." : null;
    private bool Valido => ErrorSistolica is null && ErrorDiastolica is null && ErrorTemperatura is null && ErrorOxigeno is null && ErrorPresionRelacional is null;

    private async Task GuardarAsync()
    {
        if (guardando) return;
        mostrarErrores = true;
        errorGuardado = null;
        if (!Valido) return;

        guardando = true;
        try
        {
            var resultado = await CitasApi.GuardarPreconsultaAsync(
                CitaId,
                new RegistrarPreconsultaClientRequest(sistolica!.Value, diastolica!.Value, temperatura!.Value, oxigeno!.Value, string.IsNullOrWhiteSpace(observacion) ? null : observacion.Trim()));
            if (!resultado.Exito || resultado.Valor is null)
            {
                errorGuardado = resultado.Error ?? "No fue posible guardar la preconsulta.";
                return;
            }

            preconsulta = resultado.Valor;
            editando = false;
            Toasts.Exito("Preconsulta guardada.");
        }
        finally
        {
            guardando = false;
        }
    }

    private void CambiarSistolica(ChangeEventArgs e) => sistolica = ParseShort(e.Value?.ToString());
    private void CambiarDiastolica(ChangeEventArgs e) => diastolica = ParseShort(e.Value?.ToString());
    private void CambiarTemperatura(ChangeEventArgs e) => temperatura = ParseDecimal(e.Value?.ToString());
    private void CambiarOxigeno(ChangeEventArgs e) => oxigeno = ParseDecimal(e.Value?.ToString());

    private static short? ParseShort(string? value) => short.TryParse(value, out var result) ? result : null;
    private static decimal? ParseDecimal(string? value)
    {
        if (decimal.TryParse(value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var invariant)) return invariant;
        return decimal.TryParse(value, out var current) ? current : null;
    }
    private static string TextoDecimal(decimal? value) => value?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
    private string ClaseNumero(string? error)
        => $"w-full rounded-control border bg-surface px-3 py-2 pr-12 text-sm text-ink focus:outline-none focus:ring-2 {(mostrarErrores && error is not null ? "border-state-rechazada focus:ring-state-rechazada/10" : "border-border focus:border-brand-500 focus:ring-brand-100")}";
}
