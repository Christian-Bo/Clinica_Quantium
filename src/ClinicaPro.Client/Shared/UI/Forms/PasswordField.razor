@namespace ClinicaPro.Client.Shared.UI.Forms

<div class="@CssClass">
    <label class="text-sm font-medium text-ink" for="@Id">
        @Label
        @if (Required)
        {
            <span class="text-state-rechazada"> *</span>
        }
    </label>
    <div class="@WrapperClass">
        <input id="@Id"
               type="@(showPassword ? "text" : "password")"
               autocomplete="@Autocomplete"
               placeholder="@Placeholder"
               aria-invalid="@(ShowError ? "true" : "false")"
               class="w-full min-w-0 bg-transparent text-sm text-ink placeholder:text-ink-muted/60 focus:outline-none"
               value="@Value"
               @oninput="HandleInput"
               @onblur="MarkTouched" />
        @if (ShowValid)
        {
            <span class="shrink-0 text-sm font-bold text-state-atendida" aria-hidden="true">✓</span>
        }
        else if (ShowError)
        {
            <span class="shrink-0 text-sm font-bold text-state-rechazada" aria-hidden="true">!</span>
        }
        <button type="button" class="shrink-0 rounded-pill p-1 text-ink-muted hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
                @onclick="() => showPassword = !showPassword" aria-label="@(showPassword ? "Ocultar contraseña" : "Mostrar contraseña")">
            <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="17" />
        </button>
    </div>

    @if (ShowError)
    {
        <p role="alert" class="mt-1 text-xs text-state-rechazada">@Error</p>
    }

    @if (ShowRules)
    {
        <div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-[11px]">
            <span class="@(Value.Length >= FormValidation.PasswordMinLength ? "text-state-atendida" : "text-ink-muted")">@(Value.Length >= FormValidation.PasswordMinLength ? "✓" : "•") 8+ caracteres</span>
            <span class="@(Value.Any(char.IsUpper) ? "text-state-atendida" : "text-ink-muted")">@(Value.Any(char.IsUpper) ? "✓" : "•") Una mayúscula</span>
            <span class="@(Value.Any(char.IsLower) ? "text-state-atendida" : "text-ink-muted")">@(Value.Any(char.IsLower) ? "✓" : "•") Una minúscula</span>
            <span class="@(Value.Any(char.IsDigit) ? "text-state-atendida" : "text-ink-muted")">@(Value.Any(char.IsDigit) ? "✓" : "•") Un número</span>
            <span class="@(Value.Any(c => !char.IsLetterOrDigit(c)) ? "text-state-atendida" : "text-ink-muted")">@(Value.Any(c => !char.IsLetterOrDigit(c)) ? "✓" : "•") Un símbolo</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <p class="mt-1 text-xs text-ink-muted">@HelperText</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string MatchValue { get; set; } = string.Empty;
    [Parameter] public bool ValidatePolicy { get; set; } = true;
    [Parameter] public bool ValidateMatch { get; set; }
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public bool ShowRules { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Ingresa tu contraseña";
    [Parameter] public string Autocomplete { get; set; } = "new-password";
    [Parameter] public string HelperText { get; set; } = string.Empty;
    [Parameter] public bool ForceTouched { get; set; }
    [Parameter] public int ValidationCycle { get; set; }
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private bool touched;
    private bool showPassword;
    private int previousCycle = -1;
    private string? Error
    {
        get
        {
            if (string.IsNullOrEmpty(Value)) return Required ? $"{Label} es obligatoria." : null;
            if (ValidatePolicy)
            {
                var missing = FormValidation.MissingPasswordRules(Value);
                if (missing.Count > 0) return "Falta " + string.Join(", ", missing) + ".";
            }
            if (ValidateMatch && !string.Equals(Value, MatchValue, StringComparison.Ordinal))
            {
                return "La confirmación no coincide con la contraseña nueva.";
            }
            return null;
        }
    }
    private bool ShowError => (touched || ForceTouched) && Error is not null;
    private bool ShowValid => (touched || ForceTouched) && Value.Length > 0 && Error is null;
    private string WrapperClass
    {
        get
        {
            const string baseCss = "mt-1 flex items-center gap-2 rounded-control border bg-surface px-3 py-2.5 transition-colors focus-within:ring-2";
            if (ShowError) return $"{baseCss} border-state-rechazada bg-state-rechazada/5 focus-within:ring-state-rechazada/10";
            if (ShowValid) return $"{baseCss} border-state-atendida focus-within:ring-brand-100";
            return $"{baseCss} border-border focus-within:border-brand-500 focus-within:ring-brand-100";
        }
    }

    protected override void OnParametersSet()
    {
        if (previousCycle != ValidationCycle)
        {
            touched = false;
            showPassword = false;
            previousCycle = ValidationCycle;
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        touched = true;
        await ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    }

    private void MarkTouched(FocusEventArgs _) => touched = true;
}
