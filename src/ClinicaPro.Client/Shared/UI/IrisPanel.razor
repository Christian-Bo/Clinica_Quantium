@inject CitasApiService CitasApi
@inject ToastService Toasts
@inject ConfirmDialogService Confirm
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="rounded-card border border-border bg-surface p-4" aria-labelledby="iris-titulo">
    <div class="flex items-start justify-between gap-3">
        <div>
            <p id="iris-titulo" class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">Iris</p>
            <p class="mt-0.5 text-xs text-ink-muted">Foto del iris (ojo izquierdo por defecto). Si sale borrosa, toma otra.</p>
        </div>
        @if (PuedeCapturar && !camaraAbierta)
        {
            <div class="flex shrink-0 flex-wrap justify-end gap-2">
                <label class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-control border border-border bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:bg-surface-muted">
                    <Icon Name="upload" Size="16" />
                    Subir archivo
                    <InputFile class="hidden" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" OnChange="SubirArchivoAsync" />
                </label>
                <Button Variant="ButtonVariant.Primary" Size="sm" IconName="camera" Loading="abriendoCamara" Disabled="@(subiendo || abriendoCamara)" OnClick="AbrirCamaraAsync">Tomar foto</Button>
            </div>
        }
    </div>

    @if (!PuedeCapturar && Editable)
    {
        <p class="mt-3 rounded-control bg-surface-muted px-3 py-2 text-xs text-ink-muted">Registra la llegada del paciente para tomar signos y la foto de iris.</p>
    }
    else if (PuedeCapturar && !camaraAbierta)
    {
        <div class="mt-3">
            <p class="text-xs font-medium text-ink">Ojo</p>
            <div class="mt-1 flex flex-wrap gap-2">
                @foreach (var lado in Lateralidades)
                {
                    <button type="button" class="@ClaseLado(lado)" @onclick="() => lateralidad = lado">@EtiquetaLado(lado)</button>
                }
            </div>
        </div>
    }

    @if (camaraAbierta)
    {
        <div class="mt-4 space-y-3">
            <video id="@IdVideo" class="w-full rounded-control border border-border" autoplay playsinline muted style="max-height: 280px; object-fit: contain; background: #000;"></video>
            @if (camaras.Count > 1)
            {
                <label class="block text-xs font-medium text-ink">
                    Cámara
                    <select class="mt-1 w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-ink" value="@camaraSeleccionada" @onchange="CambiarCamaraAsync">
                        @foreach (var camara in camaras)
                        {
                            <option value="@camara.DeviceId">@camara.Label</option>
                        }
                    </select>
                </label>
            }
            <div>
                <p class="text-xs font-medium text-ink">Ojo</p>
                <div class="mt-1 flex flex-wrap gap-2">
                    @foreach (var lado in Lateralidades)
                    {
                        <button type="button" class="@ClaseLado(lado)" @onclick="() => lateralidad = lado">@EtiquetaLado(lado)</button>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(errorCamara))
            {
                <p class="rounded-control bg-state-rechazada/5 px-3 py-2 text-xs text-state-rechazada">@errorCamara</p>
            }
            <div class="flex justify-end gap-2">
                <Button Variant="ButtonVariant.Ghost" Size="sm" Disabled="subiendo" OnClick="CerrarCamaraAsync">Cancelar</Button>
                <Button Variant="ButtonVariant.Primary" Size="sm" IconName="camera" Loading="subiendo" Disabled="subiendo" OnClick="CapturarYSubirAsync">Capturar y guardar</Button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="mt-3"><Skeleton Filas="2" HeightClass="h-24" /></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="mt-3 flex items-center justify-between gap-3 rounded-control bg-state-rechazada/5 px-3 py-2">
            <p class="text-xs text-state-rechazada">@errorCarga</p>
            <button type="button" class="shrink-0 text-xs font-semibold text-brand-600 hover:text-brand-700" @onclick="CargarAsync">Reintentar</button>
        </div>
    }
    else if (imagenes.Count == 0 && !camaraAbierta)
    {
        <p class="mt-3 text-sm text-ink-muted">Aún no hay fotos de iris en esta cita.</p>
    }
    else if (imagenes.Count > 0)
    {
        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            @foreach (var item in imagenes)
            {
                <figure class="overflow-hidden rounded-control border border-border bg-surface-muted">
                    @if (previews.TryGetValue(item.ImagenIrisId, out var preview))
                    {
                        <img src="@preview" alt="Iris @EtiquetaLado(item.Lateralidad)" class="h-40 w-full" style="object-fit: contain; background: #000;" />
                    }
                    else
                    {
                        <div class="flex h-40 items-center justify-center text-xs text-ink-muted">Cargando foto…</div>
                    }
                    <figcaption class="flex items-center justify-between gap-2 px-3 py-2">
                        <span class="text-xs text-ink">@EtiquetaLado(item.Lateralidad)</span>
                        @if (PuedeCapturar)
                        {
                            <button type="button" class="text-xs font-medium text-state-rechazada hover:underline" @onclick="() => QuitarAsync(item)">Quitar</button>
                        }
                    </figcaption>
                </figure>
            }
        </div>
    }
</section>

@code {
    private const long TamanoMaximo = 10 * 1024 * 1024;
    private static readonly string[] Lateralidades = ["OI", "OD", "Ambos", "No especificada"];
    private static readonly HashSet<string> TiposPermitidos = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg", "image/png", "image/webp"
    };

    [Parameter, EditorRequired] public Guid CitaId { get; set; }
    [Parameter] public string? Estado { get; set; }
    [Parameter] public bool Editable { get; set; }

    private readonly string IdVideo = "iris-camara-" + Guid.NewGuid().ToString("N");
    private List<ImagenIrisDto> imagenes = [];
    private Dictionary<Guid, string> previews = [];
    private List<CamaraDispositivo> camaras = [];
    private string? camaraSeleccionada;
    private string lateralidad = "OI";
    private Guid citaCargada;
    private bool cargando;
    private bool subiendo;
    private bool camaraAbierta;
    private bool abriendoCamara;
    private bool camaraActiva;
    private string? errorCarga;
    private string? errorCamara;

    private bool PuedeCapturar => Editable && CitaEstados.PermiteCapturaClinica(Estado);

    protected override async Task OnParametersSetAsync()
    {
        if (CitaId != Guid.Empty && CitaId != citaCargada)
        {
            citaCargada = CitaId;
            await CerrarCamaraAsync();
            await CargarAsync();
        }
    }

    private async Task CargarAsync()
    {
        cargando = true;
        errorCarga = null;
        try
        {
            imagenes = (await CitasApi.ListarImagenesIrisAsync(CitaId)).ToList();
            await CargarPreviewsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            errorCarga = MensajeUsuario.Limpiar(ex.Message, "No fue posible cargar las fotos de iris.");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarPreviewsAsync()
    {
        previews.Clear();
        foreach (var item in imagenes)
        {
            var archivo = await CitasApi.DescargarImagenIrisAsync(item.ImagenIrisId);
            if (archivo.Exito && archivo.Valor.Bytes.Length > 0)
            {
                previews[item.ImagenIrisId] = $"data:{archivo.Valor.Tipo};base64,{Convert.ToBase64String(archivo.Valor.Bytes)}";
            }
        }
    }

    private async Task SubirArchivoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo is null) return;

        if (archivo.Size > TamanoMaximo)
        {
            Toasts.Error("La imagen no puede superar 10 MB.");
            return;
        }

        var tipo = string.IsNullOrWhiteSpace(archivo.ContentType) ? TipoPorNombre(archivo.Name) : archivo.ContentType;
        if (!TiposPermitidos.Contains(tipo))
        {
            Toasts.Error("La foto debe ser JPEG, PNG o WebP.");
            return;
        }

        await using var stream = archivo.OpenReadStream(TamanoMaximo);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);
        await GuardarAsync(memoria.ToArray(), archivo.Name, tipo, lateralidad);
    }

    private async Task AbrirCamaraAsync()
    {
        errorCamara = null;
        abriendoCamara = true;
        camaraAbierta = true;
        try
        {
            var disponible = await Js.InvokeAsync<bool>("clinicaProCamara.disponible");
            if (!disponible)
            {
                errorCamara = "Este navegador no permite usar la cámara. Sube el archivo de la foto.";
                return;
            }

            await Task.Delay(50);
            camaras = await Js.InvokeAsync<List<CamaraDispositivo>>("clinicaProCamara.iniciar", IdVideo, camaraSeleccionada);
            camaraActiva = true;
            if (camaras.Count > 0 && string.IsNullOrWhiteSpace(camaraSeleccionada))
            {
                camaraSeleccionada = camaras[0].DeviceId;
            }
        }
        catch (JSException)
        {
            errorCamara = "No se pudo abrir la cámara. Permite el acceso o elige “Subir archivo” si el equipo guarda la foto en disco.";
        }
        finally
        {
            abriendoCamara = false;
        }
    }

    private async Task CambiarCamaraAsync(ChangeEventArgs e)
    {
        camaraSeleccionada = e.Value?.ToString();
        errorCamara = null;
        try
        {
            camaras = await Js.InvokeAsync<List<CamaraDispositivo>>("clinicaProCamara.iniciar", IdVideo, camaraSeleccionada);
            camaraActiva = true;
        }
        catch (JSException)
        {
            errorCamara = "No se pudo cambiar de cámara.";
        }
    }

    private async Task CapturarYSubirAsync()
    {
        errorCamara = null;
        try
        {
            var bytes = await Js.InvokeAsync<byte[]>("clinicaProCamara.capturar", IdVideo);
            if (bytes is null || bytes.Length == 0)
            {
                errorCamara = "No se obtuvo la foto. Intenta de nuevo.";
                return;
            }

            var nombre = $"iris-{lateralidad.ToLowerInvariant()}-{DateTime.Now:HHmmss}.jpg";
            var ok = await GuardarAsync(bytes, nombre, "image/jpeg", lateralidad);
            if (ok)
            {
                await CerrarCamaraAsync();
            }
        }
        catch (JSException)
        {
            errorCamara = "No se pudo capturar. Espera a ver la imagen en el visor y vuelve a intentar.";
        }
    }

    private async Task<bool> GuardarAsync(byte[] contenido, string nombre, string tipo, string lado)
    {
        subiendo = true;
        try
        {
            var resultado = await CitasApi.SubirImagenIrisAsync(CitaId, contenido, nombre, tipo, lado);
            if (!resultado.Exito || resultado.Valor is null)
            {
                Toasts.Error(resultado.Error ?? "No fue posible guardar la foto de iris.");
                errorCamara = resultado.Error;
                return false;
            }

            Toasts.Exito("Foto de iris guardada.");
            await CargarAsync();
            return true;
        }
        finally
        {
            subiendo = false;
        }
    }

    private async Task QuitarAsync(ImagenIrisDto imagen)
    {
        var confirmar = await Confirm.ConfirmarAsync(
            "La foto se desactiva y deja de mostrarse. No se borra del servidor.",
            "Quitar foto de iris",
            "Quitar",
            esPeligroso: true);
        if (!confirmar) return;

        var resultado = await CitasApi.DesactivarImagenIrisAsync(imagen.ImagenIrisId);
        if (!resultado.Exito)
        {
            Toasts.Error(resultado.Error ?? "No fue posible quitar la foto.");
            return;
        }

        Toasts.Exito("Foto de iris quitada.");
        await CargarAsync();
    }

    private async Task CerrarCamaraAsync()
    {
        if (camaraActiva)
        {
            try
            {
                await Js.InvokeVoidAsync("clinicaProCamara.detener", IdVideo);
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
            camaraActiva = false;
        }

        camaraAbierta = false;
        errorCamara = null;
        abriendoCamara = false;
    }

    private static string EtiquetaLado(string valor) => valor switch
    {
        "OD" => "Ojo derecho",
        "OI" => "Ojo izquierdo",
        "Ambos" => "Ambos",
        _ => "No especificada"
    };

    private string ClaseLado(string valor)
        => valor == lateralidad
            ? "rounded-control border border-brand-500 bg-brand-500 px-3 py-1.5 text-xs font-semibold text-white"
            : "rounded-control border border-border bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:border-brand-500";

    private static string TipoPorNombre(string nombre)
    {
        if (nombre.EndsWith(".png", StringComparison.OrdinalIgnoreCase)) return "image/png";
        if (nombre.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)) return "image/webp";
        return "image/jpeg";
    }

    public async ValueTask DisposeAsync() => await CerrarCamaraAsync();

    private sealed class CamaraDispositivo
    {
        public string deviceId { get; set; } = string.Empty;
        public string label { get; set; } = string.Empty;
        public string DeviceId => deviceId;
        public string Label => label;
    }
}
