@using ClinicaPro.Client.Features.Expediente.Models
@using ClinicaPro.Client.Features.Expediente.Services
@inject ExpedienteApiService ExpedienteApi
@inject ToastService Toasts

<Drawer IsOpen="IsOpen" IsOpenChanged="CerrarAsync" Title="Expediente clínico" MaxWidthClass="max-w-xl" CloseOnBackdrop="false">
    <Body>
        @if (cargandoPaciente)
        {
            <Skeleton Filas="5" HeightClass="h-16" />
        }
        else if (sinInformacionClinica)
        {
            <div class="py-6">
                <EmptyState IconName="file-text"
                            Title="Aún no hay información clínica"
                            Description="Este paciente todavía no tiene registros en el expediente. Cuando se agreguen datos de sus atenciones, aparecerán aquí." />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorPaciente))
        {
            <div class="py-5">
                <EmptyState IconName="alert-triangle" Title="No pudimos consultar la información" Description="@errorPaciente" />
                <div class="mt-4 flex justify-center">
                    <Button Variant="ButtonVariant.Secondary" Size="sm" IconName="refresh" OnClick="CargarPacienteAsync">Reintentar</Button>
                </div>
            </div>
        }
        else if (expediente is not null)
        {
            @if (cargandoDetalle)
            {
                <Skeleton Filas="4" HeightClass="h-16" />
            }
            else if (detalleSinInformacion)
            {
                <div class="space-y-4">
                    <button type="button" class="inline-flex items-center gap-1 text-xs font-medium text-brand-600 hover:underline" @onclick="VolverAVisitas">
                        <Icon Name="chevron-left" Size="14" /> Volver a las visitas
                    </button>
                    <EmptyState IconName="file-text"
                                Title="Aún no hay información clínica de esta atención"
                                Description="Cuando se registren signos vitales u otros datos clínicos, aparecerán aquí." />
                </div>
            }
            else if (detalle is null)
            {
                <div class="space-y-5">
                    <section>
                        <div class="flex items-start gap-3">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-100 font-semibold text-brand-700">@Iniciales(expediente.Paciente.NombreCompleto)</div>
                            <div class="min-w-0">
                                <h3 class="truncate text-base font-semibold text-ink">@expediente.Paciente.NombreCompleto</h3>
                                <p class="mt-0.5 text-xs text-ink-muted">@ResumenPaciente(expediente.Paciente)</p>
                                @if (TextoPresentacion.TieneContenido(expediente.Paciente.Telefono))
                                {
                                    <p class="mt-0.5 text-xs text-ink-muted">@FormValidation.FormatGuatemalaPhone(expediente.Paciente.Telefono)</p>
                                }
                            </div>
                        </div>

                        @if (TextoPresentacion.TieneContenido(expediente.Paciente.Alergias))
                        {
                            <div class="mt-3 flex items-start gap-2 rounded-control border border-state-solicitada/30 bg-state-solicitada/10 px-3 py-2.5">
                                <Icon Name="alert-triangle" Size="16" CssClass="mt-0.5 text-state-solicitada" />
                                <div>
                                    <p class="text-xs font-semibold text-ink">Alergias registradas</p>
                                    <p class="mt-0.5 text-xs leading-5 text-ink-muted">@TextoPresentacion.Alergias(expediente.Paciente.Alergias)</p>
                                </div>
                            </div>
                        }
                    </section>

                    @if (expediente.Visitas.Count > 0 && TieneRegistrosClinicos(expediente))
                    {
                        <div class="grid grid-cols-3 gap-2">
                            <ResumenDato Valor="@expediente.Visitas.Count.ToString()" Etiqueta="Visitas" />
                            <ResumenDato Valor="@expediente.Visitas.Count(x => x.TienePreconsulta).ToString()" Etiqueta="Con signos" />
                            <ResumenDato Valor="@expediente.Visitas.Sum(x => x.CantidadIris).ToString()" Etiqueta="Capturas" />
                        </div>
                    }

                    <section>
                        @if (expediente.Visitas.Count == 0)
                        {
                            <EmptyState IconName="calendar"
                                        Title="Aún no hay atenciones registradas"
                                        Description="El historial clínico comenzará a mostrarse aquí conforme se registren las atenciones del paciente." />
                        }
                        else
                        {
                            <div class="mb-3">
                                <h4 class="text-sm font-semibold text-ink">Atenciones</h4>
                                <p class="text-xs text-ink-muted">Selecciona una visita para consultar la información disponible.</p>
                            </div>
                            @if (!TieneRegistrosClinicos(expediente))
                            {
                                <div class="mb-3 flex items-start gap-2 rounded-control border border-border bg-surface-muted px-3 py-2.5">
                                    <Icon Name="file-text" Size="16" CssClass="mt-0.5 text-ink-muted" />
                                    <div>
                                        <p class="text-xs font-semibold text-ink">Aún no hay registros clínicos</p>
                                        <p class="mt-0.5 text-xs leading-5 text-ink-muted">Las citas ya forman parte del historial. Los signos vitales y demás registros aparecerán cuando se agreguen durante una atención.</p>
                                    </div>
                                </div>
                            }
                            <div class="space-y-2">
                                @foreach (var visita in expediente.Visitas.OrderByDescending(x => x.FechaHoraInicio))
                                {
                                    <button type="button" class="w-full rounded-control border border-border bg-surface p-3 text-left transition-colors hover:border-brand-500 hover:bg-brand-50" @onclick="() => SeleccionarVisitaAsync(visita.CitaId)">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="min-w-0">
                                                <p class="text-sm font-semibold text-ink">@visita.FechaHoraInicio.ToString("dd/MM/yyyy · HH:mm")</p>
                                                <p class="mt-0.5 truncate text-xs text-ink-muted">@NombreMedico(visita.MedicoNombre)</p>
                                            </div>
                                            <CitaStatusBadge Estado="@visita.Estado" />
                                        </div>
                                        @if (TextoPresentacion.TieneContenido(visita.MotivoConsulta))
                                        {
                                            <p class="mt-2 line-clamp-2 text-xs leading-5 text-ink-muted">@TextoPresentacion.MotivoConsulta(visita.MotivoConsulta)</p>
                                        }
                                        <div class="mt-2 flex flex-wrap gap-2 text-[11px] text-ink-muted">
                                            @if (visita.TienePreconsulta)
                                            {
                                                <span class="rounded-pill bg-surface-muted px-2 py-1">Signos vitales</span>
                                            }
                                            @if (visita.CantidadIris > 0)
                                            {
                                                <span class="rounded-pill bg-surface-muted px-2 py-1">@visita.CantidadIris captura@(visita.CantidadIris == 1 ? "" : "s") de iris</span>
                                            }
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                    </section>
                </div>
            }
            else
            {
                <div class="space-y-5">
                    <button type="button" class="inline-flex items-center gap-1 text-xs font-medium text-brand-600 hover:underline" @onclick="VolverAVisitas">
                        <Icon Name="chevron-left" Size="14" /> Volver a las visitas
                    </button>

                    <section class="rounded-card border border-border bg-surface-muted p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">Atención</p>
                                <h3 class="mt-1 text-base font-semibold text-ink">@detalle.Cita.FechaHoraInicio.ToString("dd/MM/yyyy · HH:mm")</h3>
                                <p class="mt-1 text-xs text-ink-muted">@NombreMedico(detalle.Cita.MedicoNombre) · @detalle.Cita.FechaHoraInicio.ToString("HH:mm")–@detalle.Cita.FechaHoraFin.ToString("HH:mm")</p>
                            </div>
                            <CitaStatusBadge Estado="@detalle.Cita.Estado" />
                        </div>
                        @if (TextoPresentacion.TieneContenido(detalle.Cita.MotivoConsulta))
                        {
                            <div class="mt-3 border-t border-border pt-3">
                                <p class="text-xs font-medium text-ink-muted">Motivo de consulta</p>
                                <p class="mt-1 text-sm leading-6 text-ink">@TextoPresentacion.MotivoConsulta(detalle.Cita.MotivoConsulta)</p>
                            </div>
                        }
                    </section>

                    @if (detalle.Preconsulta is null && detalle.ImagenesIris.Count == 0)
                    {
                        <EmptyState IconName="file-text"
                                    Title="Aún no hay registros clínicos en esta atención"
                                    Description="Cuando se registren signos vitales o capturas clínicas, aparecerán aquí." />
                    }
                    else
                    {
                        @if (detalle.Preconsulta is not null)
                        {
                            <section>
                                <div class="mb-2 flex items-center gap-2">
                                    <Icon Name="stethoscope" Size="16" CssClass="text-brand-600" />
                                    <h4 class="text-sm font-semibold text-ink">Signos vitales</h4>
                                </div>
                                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                                    <DatoClinico Etiqueta="Presión" Valor="@PresionTexto(detalle.Preconsulta)" Unidad="mmHg" />
                                    <DatoClinico Etiqueta="Temperatura" Valor="@detalle.Preconsulta.TemperaturaCelsius.ToString("0.0")" Unidad="°C" />
                                    <DatoClinico Etiqueta="Oxígeno" Valor="@detalle.Preconsulta.OxigenoSangrePorcentaje.ToString("0.#")" Unidad="%" />
                                    <DatoClinico Etiqueta="Registro" Valor="@FechaLocal(detalle.Preconsulta.FechaRegistroUtc).ToString("HH:mm")" Unidad="hora" />
                                </div>
                                @if (TextoPresentacion.TieneContenido(detalle.Preconsulta.Observacion))
                                {
                                    <div class="mt-2 rounded-control bg-surface-muted px-3 py-2.5">
                                        <p class="text-xs font-medium text-ink-muted">Observación</p>
                                        <p class="mt-1 text-sm leading-5 text-ink">@TextoPresentacion.Mostrar(detalle.Preconsulta.Observacion)</p>
                                    </div>
                                }
                            </section>
                        }

                        @if (detalle.ImagenesIris.Count > 0)
                        {
                            <section>
                                <div class="mb-2 flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        <Icon Name="eye" Size="16" CssClass="text-brand-600" />
                                        <h4 class="text-sm font-semibold text-ink">Capturas de iris</h4>
                                    </div>
                                    <span class="rounded-pill bg-surface-muted px-2 py-1 text-xs text-ink-muted">@detalle.ImagenesIris.Count</span>
                                </div>
                                <div class="space-y-2">
                                    @foreach (var imagen in detalle.ImagenesIris.OrderByDescending(x => x.FechaCapturaUtc))
                                    {
                                        <div class="rounded-control border border-border p-3">
                                            <div class="flex items-start justify-between gap-3">
                                                <div>
                                                    <p class="text-sm font-medium text-ink">@LateralidadTexto(imagen.Lateralidad)</p>
                                                    <p class="mt-0.5 text-xs text-ink-muted">@FechaLocal(imagen.FechaCapturaUtc).ToString("dd/MM/yyyy · HH:mm")</p>
                                                    @if (TextoPresentacion.TieneContenido(imagen.Observacion))
                                                    {
                                                        <p class="mt-1 text-xs leading-5 text-ink-muted">@TextoPresentacion.Mostrar(imagen.Observacion)</p>
                                                    }
                                                </div>
                                                <button type="button" class="shrink-0 rounded-control px-2 py-1 text-xs font-medium text-brand-600 hover:bg-brand-50" @onclick="() => AlternarImagenAsync(imagen)">
                                                    @(previews.ContainsKey(imagen.ImagenIrisId) ? "Ocultar" : "Ver captura")
                                                </button>
                                            </div>

                                            @if (cargandoImagen == imagen.ImagenIrisId)
                                            {
                                                <div class="mt-3"><Skeleton Filas="1" HeightClass="h-40" /></div>
                                            }
                                            else if (previews.TryGetValue(imagen.ImagenIrisId, out var preview))
                                            {
                                                <div class="mt-3 overflow-hidden rounded-control border border-border bg-black/40">
                                                    <img src="@preview" alt="Captura de @LateralidadTexto(imagen.Lateralidad).ToLowerInvariant()" class="max-h-52 w-full" style="object-fit: contain;" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    }
                </div>
            }
        }
    </Body>
</Drawer>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Guid? PacienteId { get; set; }
    [Parameter] public Guid? CitaInicialId { get; set; }

    private ExpedientePacienteClientDto? expediente;
    private ExpedienteCitaClientDto? detalle;
    private readonly Dictionary<Guid, string> previews = [];
    private Guid? pacienteCargado;
    private Guid? citaInicialProcesada;
    private Guid? cargandoImagen;
    private bool cargandoPaciente;
    private bool cargandoDetalle;
    private bool sinInformacionClinica;
    private bool detalleSinInformacion;
    private string? errorPaciente;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || !PacienteId.HasValue)
        {
            if (!IsOpen)
            {
                pacienteCargado = null;
                citaInicialProcesada = null;
                detalle = null;
                sinInformacionClinica = false;
                detalleSinInformacion = false;
                previews.Clear();
            }
            return;
        }

        if (PacienteId != pacienteCargado)
        {
            pacienteCargado = PacienteId;
            citaInicialProcesada = null;
            detalle = null;
            sinInformacionClinica = false;
            detalleSinInformacion = false;
            previews.Clear();
            await CargarPacienteAsync();
        }

        if (expediente is not null && CitaInicialId.HasValue && CitaInicialId != citaInicialProcesada)
        {
            citaInicialProcesada = CitaInicialId;
            await SeleccionarVisitaAsync(CitaInicialId.Value);
        }
    }

    private async Task CargarPacienteAsync()
    {
        if (!PacienteId.HasValue)
        {
            return;
        }

        cargandoPaciente = true;
        errorPaciente = null;
        sinInformacionClinica = false;
        try
        {
            var resultado = await ExpedienteApi.ObtenerPacienteAsync(PacienteId.Value);
            if (resultado.Exito && resultado.Valor is not null)
            {
                expediente = resultado.Valor;
                return;
            }

            expediente = null;
            if (resultado.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                sinInformacionClinica = true;
                return;
            }

            errorPaciente = resultado.EsProhibido
                ? "Este expediente no está disponible para tu usuario."
                : MensajeUsuario.Limpiar(resultado.Error, "No pudimos consultar la información en este momento.");
        }
        finally
        {
            cargandoPaciente = false;
        }
    }

    private async Task SeleccionarVisitaAsync(Guid citaId)
    {
        if (cargandoDetalle)
        {
            return;
        }

        cargandoDetalle = true;
        detalleSinInformacion = false;
        previews.Clear();
        try
        {
            var resultado = await ExpedienteApi.ObtenerCitaAsync(citaId);
            if (resultado.Exito && resultado.Valor is not null)
            {
                detalle = resultado.Valor;
                return;
            }

            detalle = null;
            if (resultado.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                detalleSinInformacion = true;
                return;
            }

            Toasts.Error(resultado.EsProhibido
                ? "Esta atención no está disponible para tu usuario."
                : MensajeUsuario.Limpiar(resultado.Error, "No pudimos consultar esta atención en este momento."));
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private void VolverAVisitas()
    {
        detalle = null;
        detalleSinInformacion = false;
        previews.Clear();
        citaInicialProcesada = null;
    }

    private async Task AlternarImagenAsync(IrisExpedienteDto imagen)
    {
        if (previews.ContainsKey(imagen.ImagenIrisId))
        {
            previews.Remove(imagen.ImagenIrisId);
            return;
        }

        cargandoImagen = imagen.ImagenIrisId;
        try
        {
            var resultado = await ExpedienteApi.DescargarIrisAsync(imagen.ImagenIrisId);
            if (!resultado.Exito || resultado.Valor.Bytes.Length == 0)
            {
                Toasts.Error(MensajeUsuario.Limpiar(resultado.Error, "No fue posible abrir la captura."));
                return;
            }

            previews[imagen.ImagenIrisId] = $"data:{resultado.Valor.Tipo};base64,{Convert.ToBase64String(resultado.Valor.Bytes)}";
        }
        finally
        {
            cargandoImagen = null;
        }
    }

    private async Task CerrarAsync(bool valor)
    {
        if (!valor)
        {
            detalle = null;
            sinInformacionClinica = false;
            detalleSinInformacion = false;
            previews.Clear();
            citaInicialProcesada = null;
        }
        await IsOpenChanged.InvokeAsync(valor);
    }

    private static bool TieneRegistrosClinicos(ExpedientePacienteClientDto valor)
        => valor.Visitas.Any(visita => visita.TienePreconsulta || visita.CantidadIris > 0);

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "P";
        if (partes.Length == 1) return partes[0][..1].ToUpperInvariant();
        return $"{partes[0][0]}{partes[^1][0]}".ToUpperInvariant();
    }

    private static string ResumenPaciente(PacienteContextoExpedienteDto paciente)
    {
        var partes = new List<string>();
        var sexo = paciente.Sexo switch { "F" => "Femenino", "M" => "Masculino", "X" => "Otro", _ => null };
        if (sexo is not null) partes.Add(sexo);
        if (paciente.FechaNacimiento.HasValue) partes.Add(EdadTexto(paciente.FechaNacimiento.Value));
        return partes.Count == 0 ? "Información personal no registrada" : string.Join(" · ", partes);
    }

    private static string EdadTexto(DateOnly nacimiento)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var edad = hoy.Year - nacimiento.Year;
        if (nacimiento > hoy.AddYears(-edad)) edad--;
        return $"{Math.Max(0, edad)} años";
    }

    private static string NombreMedico(string? nombre)
        => TextoPresentacion.Mostrar(nombre, "Médico no disponible");

    private static string PresionTexto(PreconsultaExpedienteDto preconsulta)
        => $"{preconsulta.PresionSistolicaMmHg}/{preconsulta.PresionDiastolicaMmHg}";

    private static string LateralidadTexto(string? valor) => valor switch
    {
        "OD" => "Ojo derecho",
        "OI" => "Ojo izquierdo",
        "Ambos" => "Ambos ojos",
        _ => "Iris"
    };

    private static DateTime FechaLocal(DateTime utc)
        => utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : utc;
}
