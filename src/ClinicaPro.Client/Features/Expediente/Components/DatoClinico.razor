<div class="rounded-control border border-border bg-surface p-3">
    <p class="text-[11px] font-medium text-ink-muted">@Etiqueta</p>
    <p class="mt-1 text-base font-semibold text-ink">@Valor</p>
    @if (!string.IsNullOrWhiteSpace(Unidad))
    {
        <p class="mt-0.5 text-[10px] text-ink-muted">@Unidad</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Valor { get; set; } = string.Empty;
    [Parameter] public string? Unidad { get; set; }
}
