@page "/notificaciones"
@attribute [Authorize(Roles = "Secretaria,Administrador")]
@inject NotificacionesApiService NotificacionesApi
@inject NavigationManager Navigation

<PageTitle>Notificaciones · Clínica Pro</PageTitle>
<AutoRefresh Enabled="true" IntervalSeconds="30" OnRefresh="CargarSilenciosoAsync" />

<div class="space-y-6">
    <div>
        <h1 class="text-xl font-semibold text-ink">Notificaciones</h1>
        <p class="text-sm text-ink-muted">Consulta el estado de los avisos automáticos enviados a pacientes.</p>
    </div>


    <div class="flex flex-wrap gap-2">
        <ChipFiltro Texto="@TextoTodas" Activo="filtroEstado is null" OnClick="() => AplicarFiltro(null)" />
        <ChipFiltro Texto="@TextoPendientes" Activo="filtroEstado == NotificacionEstados.Pendiente"
                    OnClick="() => AplicarFiltro(NotificacionEstados.Pendiente)" />
        <ChipFiltro Texto="@TextoProcesando" Activo="filtroEstado == NotificacionEstados.Procesando"
                    OnClick="() => AplicarFiltro(NotificacionEstados.Procesando)" />
        <ChipFiltro Texto="@TextoEnviadas" Activo="filtroEstado == NotificacionEstados.Enviada"
                    OnClick="() => AplicarFiltro(NotificacionEstados.Enviada)" />
        <ChipFiltro Texto="@TextoFallidas" Activo="filtroEstado == NotificacionEstados.Fallida"
                    OnClick="() => AplicarFiltro(NotificacionEstados.Fallida)" />
    </div>

    <Card BodyPadding="p-0">
        @if (cargando && notificaciones.Count == 0)
        {
            <div class="p-4"><Skeleton Filas="6" HeightClass="h-14" /></div>
        }
        else if (errorCarga is not null && notificaciones.Count == 0)
        {
            <div class="p-4">
                <EmptyState IconName="alert-triangle" Title="No se pudo cargar" Description="@errorCarga" />
                <div class="mt-3 flex justify-center"><Button Variant="ButtonVariant.Secondary" Size="sm" IconName="refresh" OnClick="CargarAsync">Reintentar</Button></div>
            </div>
        }
        else if (Filtradas.Count == 0)
        {
            <EmptyState IconName="inbox" Title="No hay notificaciones"
                        Description="@DescripcionVacia" />
        }
        else
        {
            <div class="divide-y divide-border">
                @foreach (var grupo in Filtradas.GroupBy(n => n.CreatedAtUtc.ToLocalTime().Date).OrderByDescending(g => g.Key))
                {
                    <div class="bg-surface-muted px-4 py-1.5 text-xs font-medium uppercase tracking-wide text-ink-muted">
                        @grupo.Key.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("es-GT"))
                    </div>
                    @foreach (var notificacion in grupo.OrderByDescending(n => n.CreatedAtUtc))
                    {
                        <div class="flex items-start gap-3 px-4 py-3">
                            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
                                <Icon Name="@(notificacion.Canal == "WhatsApp" ? "phone" : "mail")" Size="16" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-x-2">
                                    <p class="text-sm font-medium text-ink">@notificacion.PacienteNombre</p>
                                    <span class="text-xs text-ink-muted">· @NotificacionTipos.Etiqueta(notificacion.Tipo)</span>
                                </div>
                                <p class="mt-0.5 truncate text-sm text-ink-muted">@notificacion.Contenido</p>
                                @if (notificacion.Estado == NotificacionEstados.Fallida && notificacion.NumeroIntentos > 0)
                                {
                                    <p class="mt-1 text-xs text-state-rechazada">Intentos realizados: @notificacion.NumeroIntentos</p>
                                }
                            </div>
                            <div class="flex shrink-0 flex-col items-end gap-1">
                                <NotificacionStatusBadge Estado="@notificacion.Estado" />
                                <span class="text-xs text-ink-muted">
                                    @notificacion.CreatedAtUtc.ToLocalTime().ToString("HH:mm")
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </Card>
</div>

@code {
    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoQuery { get; set; }

    private List<NotificacionDto> todas = [];
    private List<NotificacionDto> notificaciones = [];
    private bool cargando = true;
    private bool datosCargados;
    private string? errorCarga;
    private string? filtroEstado;
    private bool inicializado;

    private IReadOnlyList<NotificacionDto> Filtradas => notificaciones
        .OrderByDescending(n => n.CreatedAtUtc)
        .ToList();

    private int Pendientes => Contar(NotificacionEstados.Pendiente);
    private int Procesando => Contar(NotificacionEstados.Procesando);
    private int Enviadas => Contar(NotificacionEstados.Enviada);
    private int Fallidas => Contar(NotificacionEstados.Fallida);

    private string TextoTodas => $"Todas ({todas.Count})";
    private string TextoPendientes => $"En cola ({Pendientes})";
    private string TextoProcesando => $"Procesando ({Procesando})";
    private string TextoEnviadas => $"Enviadas ({Enviadas})";
    private string TextoFallidas => $"Fallidas ({Fallidas})";

    private string DescripcionVacia => filtroEstado switch
    {
        NotificacionEstados.Pendiente => "No hay envíos en cola en este momento.",
        NotificacionEstados.Procesando => "No hay envíos en procesamiento en este momento.",
        NotificacionEstados.Enviada => "No hay notificaciones enviadas dentro de los registros recientes.",
        NotificacionEstados.Fallida => "No hay notificaciones fallidas. Los envíos recientes se procesaron sin errores registrados.",
        _ => "No hay notificaciones registradas recientemente."
    };

    protected override async Task OnParametersSetAsync()
    {
        var nuevoFiltro = NormalizarEstado(EstadoQuery);
        filtroEstado = nuevoFiltro;

        if (!inicializado)
        {
            inicializado = true;
            await CargarAsync();
        }
    }

    private Task CargarSilenciosoAsync() => CargarAsync(silencioso: true);

    private async Task CargarAsync() => await CargarAsync(silencioso: false);

    private async Task CargarAsync(bool silencioso)
    {
        if (!silencioso && todas.Count == 0)
        {
            cargando = true;
        }

        try
        {
            var resumenTask = NotificacionesApi.ListarAsync();
            Task<IReadOnlyList<NotificacionDto>> visiblesTask = filtroEstado is null
                ? resumenTask
                : NotificacionesApi.ListarAsync(filtroEstado);

            await Task.WhenAll(resumenTask, visiblesTask);
            todas = (await resumenTask).ToList();
            notificaciones = (await visiblesTask).ToList();
            datosCargados = true;
            errorCarga = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            if (!silencioso || !datosCargados)
            {
                errorCarga = ex.Message;
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AplicarFiltro(string? estado)
    {
        filtroEstado = estado;
        var url = estado is null
            ? "/notificaciones"
            : $"/notificaciones?estado={Uri.EscapeDataString(estado)}";
        Navigation.NavigateTo(url, replace: true);
        await CargarAsync(silencioso: notificaciones.Count > 0);
    }

    private int Contar(string estado)
    {
        var resumen = todas.Count(n => n.Estado.Equals(estado, StringComparison.OrdinalIgnoreCase));
        if (filtroEstado?.Equals(estado, StringComparison.OrdinalIgnoreCase) == true)
        {
            return Math.Max(resumen, notificaciones.Count);
        }

        return resumen;
    }

    private static string? NormalizarEstado(string? estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return null;

        return estado.Trim() switch
        {
            var x when x.Equals(NotificacionEstados.Pendiente, StringComparison.OrdinalIgnoreCase) => NotificacionEstados.Pendiente,
            var x when x.Equals(NotificacionEstados.Procesando, StringComparison.OrdinalIgnoreCase) => NotificacionEstados.Procesando,
            var x when x.Equals(NotificacionEstados.Enviada, StringComparison.OrdinalIgnoreCase) => NotificacionEstados.Enviada,
            var x when x.Equals(NotificacionEstados.Fallida, StringComparison.OrdinalIgnoreCase) => NotificacionEstados.Fallida,
            _ => null
        };
    }
}
