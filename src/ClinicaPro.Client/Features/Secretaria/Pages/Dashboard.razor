@page "/dashboard"
@attribute [Authorize(Roles = "Secretaria,Administrador")]
@inject CitasApiService CitasApi
@inject NavigationManager Navigation

<PageTitle>Dashboard · Clínica Pro</PageTitle>
<AutoRefresh Enabled="true" IntervalSeconds="45" OnRefresh="CargarSilenciosoAsync" />

<div class="space-y-6">
    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div>
            <h1 class="text-xl font-semibold text-ink">@Saludo 👋</h1>
            <p class="text-sm text-ink-muted">Resumen operativo de hoy.</p>
        </div>
        <div class="flex gap-2">
            <Button Variant="ButtonVariant.Primary" IconName="plus" OnClick="IrACitas">Nueva cita</Button>
            <Button Variant="ButtonVariant.Secondary" IconName="users" OnClick="IrAPacientes">Pacientes</Button>
        </div>
    </div>

    @if (cargando && !TieneDatos)
    {
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            @for (var i = 0; i < 4; i++)
            {
                <Skeleton Filas="1" HeightClass="h-24" />
            }
        </div>
        <Card><Skeleton Filas="6" /></Card>
    }
    else if (!TieneDatos && errorCarga is not null)
    {
        <Card>
            <EmptyState IconName="alert-triangle" Title="No se pudo cargar el resumen" Description="No fue posible obtener la información operativa. El sistema volverá a intentarlo automáticamente." />
            <div class="mt-3 flex justify-center">
                <Button Variant="ButtonVariant.Secondary" Size="sm" IconName="refresh" OnClick="CargarAsync">Reintentar</Button>
            </div>
        </Card>
    }
    else
    {
        @if (pendientesTotal > 0)
        {
            <button type="button"
                    class="flex w-full items-center justify-between rounded-card border border-state-solicitada/30 bg-state-solicitada/10 px-4 py-3 text-left transition-colors hover:bg-brand-50"
                    @onclick="IrAPendientes">
                <span class="flex items-center gap-2 text-sm font-medium text-state-solicitada">
                    <Icon Name="clock" Size="16" />
                    @TextoPendientesConfirmar
                </span>
                <span class="hidden items-center gap-2 text-xs text-state-solicitada sm:flex">
                    Revisar solicitudes
                    <Icon Name="arrow-right" Size="16" CssClass="text-state-solicitada" />
                </span>
            </button>
        }

        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            <TarjetaKpi Titulo="Citas hoy" Valor="totalHoy" IconName="calendar" OnClick="IrACitas" />
            <TarjetaKpi Titulo="Pendientes de confirmar" Valor="pendientesTotal" IconName="clock" OnClick="IrAPendientes" />
            <TarjetaKpi Titulo="Pacientes en sala" Valor="enSalaHoy" IconName="users" OnClick="IrACitas" />
            <TarjetaKpi Titulo="No se presentaron" Valor="noPresentadosHoy" IconName="alert-triangle" OnClick="IrACitas" />
        </div>

        <Card Title="Agenda del día" IconName="calendar">
            <HeaderActions>
                <Button Variant="ButtonVariant.Ghost" Size="sm" OnClick="IrACitas">Ver completa</Button>
            </HeaderActions>
            <ChildContent>
                @if (citasHoy.Count == 0)
                {
                    <EmptyState IconName="calendar" Title="Sin citas hoy"
                                Description="Cuando se programen citas para hoy aparecerán aquí." />
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead>
                                <tr class="text-xs uppercase tracking-wide text-ink-muted">
                                    <th class="pb-2 pr-3 font-medium">Hora</th>
                                    <th class="pb-2 pr-3 font-medium">Paciente</th>
                                    <th class="pb-2 pr-3 font-medium">Médico</th>
                                    <th class="pb-2 pr-3 font-medium">Estado</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                @foreach (var cita in citasHoy.OrderBy(c => c.FechaHoraInicio))
                                {
                                    <tr class="@ClaseFila(cita) cursor-pointer" @onclick="() => AbrirDetalle(cita)">
                                        <td class="py-2 pr-3 font-medium text-ink">@cita.FechaHoraInicio.ToString("HH:mm")</td>
                                        <td class="py-2 pr-3 text-ink">@cita.PacienteNombre</td>
                                        <td class="py-2 pr-3 text-ink-muted">@cita.MedicoNombre</td>
                                        <td class="py-2 pr-3"><CitaStatusBadge Estado="@cita.Estado" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ChildContent>
        </Card>
    }
</div>

<CitaDetalleDrawer IsOpen="drawerAbierto" IsOpenChanged="@((bool v) => drawerAbierto = v)"
                    Cita="citaSeleccionada" OnActualizada="ManejarCitaActualizada" />

@code {
    private bool cargando = true;
    private bool refrescando;
    private string? errorCarga;
    private int totalHoy;
    private int pendientesTotal;
    private int enSalaHoy;
    private int noPresentadosHoy;
    private List<CitaDto> citasHoy = [];

    private bool TieneDatos => citasHoy.Count > 0 || totalHoy > 0 || pendientesTotal > 0 || enSalaHoy > 0 || noPresentadosHoy > 0;

    private string TextoPendientesConfirmar => pendientesTotal == 1
        ? "1 solicitud de cita pendiente de confirmar"
        : $"{pendientesTotal} solicitudes de cita pendientes de confirmar";

    private bool drawerAbierto;
    private CitaDto? citaSeleccionada;

    private static string Saludo => DateTime.Now.Hour switch
    {
        >= 5 and < 12 => "Buenos días",
        >= 12 and < 19 => "Buenas tardes",
        _ => "Buenas noches"
    };

    protected override async Task OnInitializedAsync() => await CargarAsync(silencioso: false);

    private Task CargarSilenciosoAsync() => CargarAsync(silencioso: true);
    private Task CargarAsync() => CargarAsync(silencioso: false);

    private async Task CargarAsync(bool silencioso)
    {
        if (refrescando) return;
        refrescando = true;

        var hoy = DateTime.Today;
        var manana = hoy.AddDays(1);
        if (!silencioso && !TieneDatos) cargando = true;

        try
        {
            var agendaTask = CitasApi.ListarAgendaAsync(hoy, manana);
            var pendientesTask = CitasApi.ListarPendientesAsync();

            await Task.WhenAll(agendaTask, pendientesTask);

            citasHoy = (await agendaTask).ToList();
            pendientesTotal = (await pendientesTask).Count;
            totalHoy = citasHoy.Count;
            enSalaHoy = citasHoy.Count(c => c.Estado is CitaEstados.EnEspera or CitaEstados.EnAtencion);
            noPresentadosHoy = citasHoy.Count(c => c.Estado == CitaEstados.NoPresentada);
            errorCarga = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            errorCarga = ex.Message;
        }
        finally
        {
            cargando = false;
            refrescando = false;
        }
    }


    private Guid? ProximaCitaId => citasHoy
        .Where(c => c.FechaHoraInicio >= DateTime.Now && c.Estado is CitaEstados.Programada or CitaEstados.Confirmada)
        .OrderBy(c => c.FechaHoraInicio)
        .Select(c => (Guid?)c.CitaId)
        .FirstOrDefault();

    private string ClaseFila(CitaDto cita) => cita.CitaId == ProximaCitaId
        ? "border-l-2 border-l-brand-500 bg-brand-50 hover:bg-brand-100"
        : "hover:bg-surface-muted";

    private void AbrirDetalle(CitaDto cita)
    {
        citaSeleccionada = cita;
        drawerAbierto = true;
    }

    private Task ManejarCitaActualizada(CitaDto cita) => CargarAsync(silencioso: true);
    private void IrACitas() => Navigation.NavigateTo("/citas");
    private void IrAPendientes() => Navigation.NavigateTo("/citas?tab=pendientes");
    private void IrAPacientes() => Navigation.NavigateTo("/pacientes");
}
