<div class="rounded-card border border-border bg-surface p-4 shadow-card">
    <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-control bg-brand-100 text-brand-600">
            <Icon Name="@IconName" Size="20" />
        </div>
        <div class="min-w-0">
            <p class="text-2xl font-semibold text-ink">@Valor</p>
            <p class="truncate text-xs text-ink-muted">@Titulo</p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public int Valor { get; set; }
    [Parameter, EditorRequired] public string IconName { get; set; } = string.Empty;
}
