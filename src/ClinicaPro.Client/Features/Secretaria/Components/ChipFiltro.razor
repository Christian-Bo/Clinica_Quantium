<button type="button" class="@Clases" @onclick="ManejarClick">
    @Texto
</button>

@code {
    [Parameter, EditorRequired] public string Texto { get; set; } = string.Empty;
    [Parameter] public bool Activo { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private Task ManejarClick() => OnClick.HasDelegate ? OnClick.InvokeAsync() : Task.CompletedTask;

    private string Clases => Activo
        ? "rounded-pill bg-brand-500 px-3 py-1.5 text-xs font-medium text-white transition-colors"
        : "rounded-pill border border-border bg-surface px-3 py-1.5 text-xs font-medium text-ink-muted transition-colors hover:bg-surface-muted";
}
