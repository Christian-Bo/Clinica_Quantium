<div class="grid grid-cols-7 gap-px overflow-hidden rounded-control border border-border bg-border">
    @foreach (var nombreDia in NombresDias)
    {
        <div class="bg-surface-muted px-2 py-1.5 text-center text-xs font-medium uppercase text-ink-muted">
            @nombreDia
        </div>
    }

    @foreach (var dia in DiasDelCalendario)
    {
        var citasDelDia = Citas.Where(c => DateOnly.FromDateTime(c.FechaHoraInicio) == dia).ToList();
        var esDelMes = dia.Month == Mes.Month;

        <button type="button"
                class="@ClaseCelda(esDelMes)"
                @onclick="() => OnSeleccionarDia.InvokeAsync(dia)">
            <span class="@(dia == Hoy ? "flex h-5 w-5 items-center justify-center rounded-full bg-brand-500 text-xs font-semibold text-white" : "text-xs font-medium")">
                @dia.Day
            </span>

            @if (citasDelDia.Count > 0)
            {
                <span class="mt-1 inline-flex items-center gap-1 rounded-pill bg-brand-100 px-1.5 py-0.5 text-[10px] font-medium text-brand-700">
                    @citasDelDia.Count cita@(citasDelDia.Count == 1 ? "" : "s")
                </span>
            }
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DateOnly Mes { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<CitaDto> Citas { get; set; } = [];
    [Parameter] public EventCallback<DateOnly> OnSeleccionarDia { get; set; }

    private static readonly string[] NombresDias = ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"];
    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);

    private List<DateOnly> DiasDelCalendario
    {
        get
        {
            var primerDiaDelMes = new DateOnly(Mes.Year, Mes.Month, 1);
            var inicio = primerDiaDelMes.AddDays(-(int)primerDiaDelMes.DayOfWeek);
            return Enumerable.Range(0, 42).Select(inicio.AddDays).ToList();
        }
    }

    private static string ClaseCelda(bool esDelMes)
    {
        const string baseClase = "flex min-h-[4.5rem] flex-col items-start gap-0.5 bg-surface p-2 text-left transition-colors hover:bg-surface-muted ";
        return baseClase + (esDelMes ? "text-ink" : "text-ink-muted/50");
    }
}
