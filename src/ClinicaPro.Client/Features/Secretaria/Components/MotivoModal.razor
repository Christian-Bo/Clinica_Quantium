<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Title="@Titulo" IconName="alert-triangle" MaxWidthClass="max-w-sm">
    <Body>
        <label class="text-sm font-medium text-ink">@Etiqueta</label>
        <textarea rows="3" placeholder="@Placeholder"
                  class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                  value="@motivo" @oninput="e => motivo = e.Value?.ToString() ?? string.Empty"></textarea>
    </Body>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="Cancelar">Volver</Button>
        <Button Variant="ButtonVariant.Danger" Loading="enviando" OnClick="Confirmar">@TextoBoton</Button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = "Motivo";
    [Parameter] public string Etiqueta { get; set; } = "Motivo";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string TextoBoton { get; set; } = "Confirmar";
    [Parameter] public EventCallback<string> OnConfirmar { get; set; }

    private string motivo = string.Empty;
    private bool enviando;
    private bool isOpenAnterior;

    protected override void OnParametersSet()
    {
        if (IsOpen && !isOpenAnterior)
        {
            motivo = string.Empty;
        }

        isOpenAnterior = IsOpen;
    }

    private async Task Confirmar()
    {
        enviando = true;
        await OnConfirmar.InvokeAsync(motivo);
        enviando = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Cancelar() => await IsOpenChanged.InvokeAsync(false);
}
