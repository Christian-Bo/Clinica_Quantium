@page "/admin/especialidades"
@attribute [Authorize(Roles = Roles.Administrador)]
@inject AdminApiService AdminApi
@inject ConfirmDialogService Confirmar
@inject ToastService Toast

<PageTitle>Especialidades · Administración</PageTitle>

<div class="space-y-5">
    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Catálogo clínico</p>
            <h1 class="mt-1 text-xl font-semibold text-ink">Especialidades</h1>
            <p class="mt-1 text-sm text-ink-muted">Crea, edita, activa o desactiva las especialidades disponibles para citas.</p>
        </div>
        <Button Variant="ButtonVariant.Primary" IconName="plus" OnClick="Nueva">Nueva especialidad</Button>
    </div>

    <Card BodyPadding="p-0">
        <div class="flex flex-col gap-3 border-b border-border p-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="relative w-full sm:max-w-sm">
                <span class="pointer-events-none absolute left-3 top-2.5 text-ink-muted"><Icon Name="search" Size="17" /></span>
                <input class="w-full rounded-control border border-border py-2 pl-9 pr-3 text-sm text-ink focus:border-brand-500 focus:outline-none" placeholder="Buscar especialidad..." @bind="busqueda" @bind:event="oninput" />
            </div>
            <div class="flex gap-2 text-xs">
                <button class="rounded-pill px-3 py-1.5 @(filtro == "todas" ? "bg-brand-100 text-brand-700" : "bg-surface-muted text-ink-muted")" @onclick="FiltrarTodas">Todas</button>
                <button class="rounded-pill px-3 py-1.5 @(filtro == "activas" ? "bg-brand-100 text-brand-700" : "bg-surface-muted text-ink-muted")" @onclick="FiltrarActivas">Activas</button>
                <button class="rounded-pill px-3 py-1.5 @(filtro == "inactivas" ? "bg-brand-100 text-brand-700" : "bg-surface-muted text-ink-muted")" @onclick="FiltrarInactivas">Inactivas</button>
            </div>
        </div>

        @if (cargando)
        {
            <div class="p-5"><Skeleton Filas="5" /></div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="p-5"><EmptyState IconName="alert-triangle" Title="No se pudieron cargar las especialidades" Description="@error" /></div>
        }
        else if (Filtradas.Count == 0)
        {
            <div class="p-5"><EmptyState IconName="clipboard-list" Title="Sin resultados" Description="No hay especialidades que coincidan con los filtros actuales." /></div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px] text-left text-sm">
                    <thead class="bg-surface-muted text-xs uppercase tracking-wide text-ink-muted">
                        <tr><th class="px-5 py-3 font-medium">Especialidad</th><th class="px-5 py-3 font-medium">Descripción</th><th class="px-5 py-3 font-medium">Estado</th><th class="px-5 py-3 text-right font-medium">Acciones</th></tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var item in Filtradas)
                        {
                            <tr class="hover:bg-surface-muted/60">
                                <td class="px-5 py-3 font-medium text-ink">@item.Nombre</td>
                                <td class="max-w-md px-5 py-3 text-ink-muted">@(item.Descripcion ?? "Sin descripción")</td>
                                <td class="px-5 py-3"><span class="inline-flex rounded-pill px-2.5 py-1 text-xs font-medium @(item.IsActive ? "bg-brand-100 text-brand-700" : "bg-surface-muted text-ink-muted")">@(item.IsActive ? "Activa" : "Inactiva")</span></td>
                                <td class="px-5 py-3"><div class="flex justify-end gap-1"><Button Variant="ButtonVariant.Ghost" Size="sm" IconName="edit" OnClick="() => Editar(item)">Editar</Button><Button Variant="ButtonVariant.Ghost" Size="sm" IconName="@(item.IsActive ? "x" : "check")" OnClick="() => CambiarEstadoAsync(item)">@(item.IsActive ? "Desactivar" : "Activar")</Button></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>
</div>

<EspecialidadAdminModal IsOpen="modalAbierto" IsOpenChanged="@(v => modalAbierto = v)" Especialidad="seleccionada" OnGuardado="CargarAsync" />

@code {
    private bool cargando = true;
    private string? error;
    private string busqueda = string.Empty;
    private string filtro = "todas";
    private IReadOnlyList<EspecialidadAdminItem> especialidades = [];
    private bool modalAbierto;
    private EspecialidadAdminItem? seleccionada;

    private IReadOnlyList<EspecialidadAdminItem> Filtradas => especialidades
        .Where(x => filtro == "todas" || (filtro == "activas" && x.IsActive) || (filtro == "inactivas" && !x.IsActive))
        .Where(x => string.IsNullOrWhiteSpace(busqueda) || x.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || (x.Descripcion?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try { especialidades = await AdminApi.ListarEspecialidadesAsync(); error = null; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { error = "No se pudo contactar a la API."; }
        finally { cargando = false; }
    }

    private void FiltrarTodas() => filtro = "todas";
    private void FiltrarActivas() => filtro = "activas";
    private void FiltrarInactivas() => filtro = "inactivas";

    private void Nueva() { seleccionada = null; modalAbierto = true; }
    private void Editar(EspecialidadAdminItem item) { seleccionada = item; modalAbierto = true; }

    private async Task CambiarEstadoAsync(EspecialidadAdminItem item)
    {
        var accion = item.IsActive ? "desactivar" : "activar";
        var ok = await Confirmar.ConfirmarAsync($"¿Deseas {accion} la especialidad {item.Nombre}?", "Cambiar estado", char.ToUpper(accion[0]) + accion[1..], item.IsActive);
        if (!ok) return;

        var resultado = await AdminApi.ActualizarEspecialidadAsync(item.EspecialidadId, new ActualizarEspecialidadRequest(item.Nombre, item.Descripcion, !item.IsActive));
        if (!resultado.Exito) { Toast.Error(resultado.Error ?? "No fue posible cambiar el estado."); return; }
        Toast.Exito($"Especialidad {(item.IsActive ? "desactivada" : "activada")}.");
        await CargarAsync();
    }
}
