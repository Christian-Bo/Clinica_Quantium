@page "/admin/parametros"
@attribute [Authorize(Roles = Roles.Administrador)]
@inject AdminApiService AdminApi

<PageTitle>Ajustes de citas · Administración</PageTitle>
<AutoRefresh Enabled="@(!string.IsNullOrWhiteSpace(error))" IntervalSeconds="12" OnRefresh="CargarAsync" />

<div class="space-y-5">
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Configuración</p>
        <h1 class="mt-1 text-xl font-semibold text-ink">Ajustes de citas</h1>
        <p class="mt-1 text-sm text-ink-muted">Configura tiempos y límites usados al gestionar las citas.</p>
    </div>

    @if (cargando)
    {
        <Skeleton Filas="4" HeightClass="h-24" />
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <Card>
            <EmptyState IconName="alert-triangle" Title="No se pudieron cargar los ajustes" Description="@error" />
            <div class="mt-3 flex justify-center"><Button Variant="ButtonVariant.Secondary" Size="sm" IconName="refresh" OnClick="CargarAsync">Reintentar</Button></div>
        </Card>
    }
    else
    {
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            @foreach (var parametro in parametros.OrderBy(x => x.Clave))
            {
                <Card>
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-ink">@NombreAjuste(parametro)</p>
                            <p class="mt-1 text-sm leading-5 text-ink-muted">@DescripcionAjuste(parametro)</p>
                            <div class="mt-3 flex items-baseline gap-2">
                                <span class="text-xs text-ink-muted">Valor actual</span>
                                <span class="rounded-control bg-brand-50 px-2.5 py-1 text-sm font-semibold text-brand-700">@ValorVisible(parametro)</span>
                            </div>
                        </div>
                        @if (EsEditable(parametro))
                        {
                            <Button Variant="ButtonVariant.Ghost" Size="sm" IconName="edit" OnClick="() => Editar(parametro)">Editar</Button>
                        }
                    </div>
                </Card>
            }
        </div>
    }
</div>

<ParametroAdminModal IsOpen="modalAbierto" IsOpenChanged="@(v => modalAbierto = v)" Parametro="seleccionado" OnGuardado="CargarAsync" />

@code {
    private const string MaximoReprogramaciones = "Citas.MaximoReprogramaciones";

    private bool cargando = true;
    private string? error;
    private IReadOnlyList<ParametroDto> parametros = [];
    private ParametroDto? seleccionado;
    private bool modalAbierto;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        cargando = parametros.Count == 0;
        error = null;
        try
        {
            parametros = await AdminApi.ListarParametrosAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            error = MensajeUsuario.Limpiar(ex.Message, "No pudimos cargar los ajustes. Revisa tu conexión e intenta nuevamente.");
        }
        finally
        {
            cargando = false;
        }
    }

    private void Editar(ParametroDto parametro)
    {
        if (!EsEditable(parametro)) return;
        seleccionado = parametro;
        modalAbierto = true;
    }

    private static bool EsEditable(ParametroDto parametro)
        => !parametro.Clave.Equals(MaximoReprogramaciones, StringComparison.OrdinalIgnoreCase);

    private static string NombreAjuste(ParametroDto parametro) => parametro.Clave switch
    {
        "Citas.HorasMinimasCancelacion" => "Anticipación para cancelar",
        "Citas.MaximoReprogramaciones" => "Máximo de reprogramaciones",
        "Citas.DuracionPredeterminadaMinutos" => "Duración de las citas",
        "Citas.MaximoActivasPorPaciente" => "Citas activas por paciente",
        _ => "Ajuste general"
    };

    private static string DescripcionAjuste(ParametroDto parametro) => parametro.Clave switch
    {
        "Citas.HorasMinimasCancelacion" => "Tiempo mínimo para cancelar una cita sin marcar inasistencia.",
        "Citas.MaximoReprogramaciones" => "Cantidad máxima de veces que puede cambiarse la fecha de una cita.",
        "Citas.DuracionPredeterminadaMinutos" => "Tiempo asignado por defecto a cada cita.",
        "Citas.MaximoActivasPorPaciente" => "Cantidad máxima de citas activas permitidas por paciente.",
        _ => "Configuración general de la clínica."
    };

    private static string ValorVisible(ParametroDto parametro)
    {
        if (parametro.TipoDato.Equals("Bool", StringComparison.OrdinalIgnoreCase))
            return parametro.Valor.Equals("true", StringComparison.OrdinalIgnoreCase) ? "Sí" : "No";

        if (parametro.Clave.Equals("Citas.HorasMinimasCancelacion", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(parametro.Valor, out var horas))
            return horas == 1 ? "1 hora" : $"{horas} horas";

        if (parametro.Clave.Equals("Citas.DuracionPredeterminadaMinutos", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(parametro.Valor, out var minutos))
            return $"{minutos} min";

        if (parametro.Clave.Equals("Citas.MaximoActivasPorPaciente", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(parametro.Valor, out var citas))
            return citas == 1 ? "1 cita" : $"{citas} citas";

        return parametro.Valor;
    }
}
