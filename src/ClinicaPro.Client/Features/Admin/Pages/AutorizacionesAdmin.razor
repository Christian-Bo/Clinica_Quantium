@page "/admin/autorizaciones"
@attribute [Authorize(Roles = Roles.Administrador)]
@inject AdminApiService AdminApi

<PageTitle>Autorizaciones · Administración</PageTitle>

<div class="space-y-5">
    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Control excepcional</p>
            <h1 class="mt-1 text-xl font-semibold text-ink">Autorizaciones de reprogramación</h1>
            <p class="mt-1 text-sm text-ink-muted">Resuelve las solicitudes requeridas para una tercera reprogramación.</p>
        </div>
        <Button Variant="ButtonVariant.Secondary" IconName="refresh" Loading="cargando" OnClick="CargarAsync">Actualizar</Button>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <TarjetaKpi Titulo="Pendientes" Valor="Pendientes" IconName="clock" />
        <TarjetaKpi Titulo="Aprobadas" Valor="Aprobadas" IconName="check-circle" />
        <TarjetaKpi Titulo="Rechazadas" Valor="Rechazadas" IconName="x" />
        <TarjetaKpi Titulo="Usadas" Valor="Usadas" IconName="history" />
    </div>

    <Card BodyPadding="p-0">
        <div class="flex flex-col gap-3 border-b border-border p-4 sm:flex-row sm:items-center">
            <div class="relative flex-1 sm:max-w-sm">
                <span class="pointer-events-none absolute left-3 top-2.5 text-ink-muted"><Icon Name="search" Size="17" /></span>
                <input class="w-full rounded-control border border-border py-2 pl-9 pr-3 text-sm text-ink focus:border-brand-500 focus:outline-none" placeholder="Buscar por cita, solicitante o motivo..." @bind="busqueda" @bind:event="oninput" />
            </div>
            <select class="rounded-control border border-border bg-surface px-3 py-2 text-sm text-ink" @bind="estadoFiltro">
                <option value="">Todos los estados</option>
                <option value="Pendiente">Pendientes</option><option value="Aprobada">Aprobadas</option><option value="Rechazada">Rechazadas</option><option value="Usada">Usadas</option>
            </select>
        </div>

        @if (cargando)
        {
            <div class="p-5"><Skeleton Filas="6" /></div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="p-5"><EmptyState IconName="alert-triangle" Title="No se pudieron cargar las autorizaciones" Description="@error" /></div>
        }
        else if (Filtradas.Count == 0)
        {
            <div class="p-5"><EmptyState IconName="shield" Title="Sin autorizaciones" Description="No hay solicitudes que coincidan con los filtros." /></div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px] text-left text-sm">
                    <thead class="bg-surface-muted text-xs uppercase tracking-wide text-ink-muted"><tr><th class="px-5 py-3 font-medium">Solicitud</th><th class="px-5 py-3 font-medium">Solicitada por</th><th class="px-5 py-3 font-medium">Cita</th><th class="px-5 py-3 font-medium">Motivo</th><th class="px-5 py-3 font-medium">Estado</th><th class="px-5 py-3 font-medium">Decisión</th><th class="px-5 py-3 text-right font-medium">Acciones</th></tr></thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var item in Filtradas)
                        {
                            <tr class="hover:bg-surface-muted/60">
                                <td class="whitespace-nowrap px-5 py-3"><p class="font-medium text-ink">@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</p><p class="text-xs text-ink-muted">@item.CreatedAtUtc.ToLocalTime().ToString("HH:mm") · #@Corto(item.AutorizacionId)</p></td>
                                <td class="px-5 py-3"><p class="text-sm text-ink">@Solicitante(item.SolicitadaPorUsuarioId)</p><p class="text-xs text-ink-muted">Secretaría</p></td>
                                <td class="px-5 py-3"><span class="font-mono text-xs text-ink">#@Corto(item.CitaId)</span></td>
                                <td class="max-w-sm px-5 py-3 text-ink-muted">@item.MotivoSolicitud</td>
                                <td class="px-5 py-3"><span class="inline-flex rounded-pill px-2.5 py-1 text-xs font-medium @ClaseEstado(item.Estado)">@EtiquetaEstado(item.Estado)</span></td>
                                <td class="max-w-sm px-5 py-3 text-ink-muted">@(string.IsNullOrWhiteSpace(item.MotivoDecision) ? "—" : item.MotivoDecision)</td>
                                <td class="px-5 py-3">
                                    @if (item.Estado.Equals("Pendiente", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="flex justify-end gap-1"><Button Variant="ButtonVariant.Primary" Size="sm" IconName="check" OnClick="() => AbrirDecision(item, true)">Aprobar</Button><Button Variant="ButtonVariant.Ghost" Size="sm" IconName="x" OnClick="() => AbrirDecision(item, false)">Rechazar</Button></div>
                                    }
                                    else
                                    {
                                        <p class="text-right text-xs text-ink-muted">@(item.DecididaAtUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "Resuelta")</p>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>
</div>

<DecisionAutorizacionModal IsOpen="modalAbierto" IsOpenChanged="@(v => modalAbierto = v)" Autorizacion="seleccionada" Aprobar="decisionAprobar" OnGuardado="CargarAsync" />

@code {
    private bool cargando = true;
    private string? error;
    private string busqueda = string.Empty;
    private string estadoFiltro = string.Empty;
    private IReadOnlyList<AutorizacionReprogramacionDto> autorizaciones = [];
    private IReadOnlyList<UsuarioAdminDto> usuarios = [];
    private bool modalAbierto;
    private bool decisionAprobar;
    private AutorizacionReprogramacionDto? seleccionada;

    private int Pendientes => ContarEstado("Pendiente");
    private int Aprobadas => ContarEstado("Aprobada");
    private int Rechazadas => ContarEstado("Rechazada");
    private int Usadas => ContarEstado("Usada");

    private IReadOnlyList<AutorizacionReprogramacionDto> Filtradas => autorizaciones
        .Where(x => string.IsNullOrWhiteSpace(estadoFiltro) || x.Estado.Equals(estadoFiltro, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(busqueda) || x.CitaId.ToString().Contains(busqueda, StringComparison.OrdinalIgnoreCase) || x.AutorizacionId.ToString().Contains(busqueda, StringComparison.OrdinalIgnoreCase) || x.MotivoSolicitud.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || Solicitante(x.SolicitadaPorUsuarioId).Contains(busqueda, StringComparison.OrdinalIgnoreCase) || (x.MotivoDecision?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(x => OrdenEstado(x.Estado)).ThenByDescending(x => x.CreatedAtUtc).ToList();

    protected override async Task OnInitializedAsync() => await CargarAsync();
    private async Task CargarAsync()
    {
        cargando = autorizaciones.Count == 0;
        try
        {
            var autorizacionesTask = AdminApi.ListarAutorizacionesAsync();
            var usuariosTask = AdminApi.ListarUsuariosAsync();
            await Task.WhenAll(autorizacionesTask, usuariosTask);
            autorizaciones = await autorizacionesTask;
            usuarios = await usuariosTask;
            error = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { error = "No se pudo contactar a la API."; }
        finally { cargando = false; }
    }
    private void AbrirDecision(AutorizacionReprogramacionDto item, bool aprobar) { seleccionada = item; decisionAprobar = aprobar; modalAbierto = true; }
    private int ContarEstado(string estado) => autorizaciones.Count(x => x.Estado.Equals(estado, StringComparison.OrdinalIgnoreCase));
    private string Solicitante(Guid usuarioId) => usuarios.FirstOrDefault(x => x.UsuarioId == usuarioId)?.Email ?? $"Usuario #{Corto(usuarioId)}";
    private static string Corto(Guid id) => id.ToString()[..8];
    private static int OrdenEstado(string estado) => estado.Equals("Pendiente", StringComparison.OrdinalIgnoreCase) ? 0 : 1;
    private static string EtiquetaEstado(string estado) => estado switch { "Usada" => "Utilizada", _ => estado };
    private static string ClaseEstado(string estado) => estado switch
    {
        "Pendiente" => "bg-state-solicitada/10 text-state-solicitada", "Aprobada" => "bg-brand-100 text-brand-700",
        "Rechazada" => "bg-state-rechazada/10 text-state-rechazada", _ => "bg-surface-muted text-ink-muted"
    };
}
