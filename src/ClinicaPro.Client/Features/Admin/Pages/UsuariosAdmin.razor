@page "/admin/usuarios"
@attribute [Authorize(Roles = Roles.Administrador)]
@inject AdminApiService AdminApi
@inject ConfirmDialogService Confirmar
@inject ToastService Toast

<PageTitle>Usuarios y roles · Administración</PageTitle>

<div class="space-y-5">
    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Seguridad y acceso</p>
            <h1 class="mt-1 text-xl font-semibold text-ink">Usuarios y roles</h1>
            <p class="mt-1 text-sm text-ink-muted">Crea personal administrativo, asigna roles y controla el acceso al sistema.</p>
        </div>
        <Button Variant="ButtonVariant.Primary" IconName="user-plus" OnClick="NuevoUsuario">Nuevo usuario</Button>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <TarjetaKpi Titulo="Usuarios" Valor="TotalUsuarios" IconName="users" />
        <TarjetaKpi Titulo="Activos" Valor="UsuariosActivos" IconName="user-check" />
        <TarjetaKpi Titulo="Administradores" Valor="Administradores" IconName="shield" />
        <TarjetaKpi Titulo="Secretaría" Valor="Secretarias" IconName="clipboard-list" />
    </div>

    <Card BodyPadding="p-0">
        <div class="flex flex-col gap-3 border-b border-border p-4 sm:flex-row">
            <div class="relative flex-1 sm:max-w-sm">
                <span class="pointer-events-none absolute left-3 top-2.5 text-ink-muted"><Icon Name="search" Size="17" /></span>
                <input class="w-full rounded-control border border-border py-2 pl-9 pr-3 text-sm text-ink focus:border-brand-500 focus:outline-none" placeholder="Buscar correo..." @bind="busqueda" @bind:event="oninput" />
            </div>
            <select class="rounded-control border border-border bg-surface px-3 py-2 text-sm text-ink" @bind="rolFiltro">
                <option value="">Todos los roles</option>
                <option value="Administrador">Administrador</option>
                <option value="Secretaria">Secretaría</option>
                <option value="Medico">Médico</option>
                <option value="Paciente">Paciente</option>
            </select>
            <select class="rounded-control border border-border bg-surface px-3 py-2 text-sm text-ink" @bind="estadoFiltro">
                <option value="">Todos</option>
                <option value="activo">Activos</option>
                <option value="inactivo">Inactivos</option>
            </select>
        </div>

        @if (cargando)
        {
            <div class="p-5"><Skeleton Filas="6" /></div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="p-5">
                <EmptyState IconName="alert-triangle" Title="No se pudieron cargar los usuarios" Description="@error" />
                <div class="mt-3 flex justify-center"><Button Variant="ButtonVariant.Secondary" Size="sm" IconName="refresh" OnClick="CargarAsync">Reintentar</Button></div>
            </div>
        }
        else if (Filtrados.Count == 0)
        {
            <div class="p-5"><EmptyState IconName="users" Title="Sin resultados" Description="No hay usuarios que coincidan con los filtros." /></div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[780px] text-left text-sm">
                    <thead class="bg-surface-muted text-xs uppercase tracking-wide text-ink-muted">
                        <tr><th class="px-5 py-3 font-medium">Usuario</th><th class="px-5 py-3 font-medium">Roles</th><th class="px-5 py-3 font-medium">Estado</th><th class="px-5 py-3 text-right font-medium">Acciones</th></tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var usuario in Filtrados)
                        {
                            var esStaffEditable = EsStaffEditable(usuario);
                            <tr class="hover:bg-surface-muted/60">
                                <td class="px-5 py-3"><p class="font-medium text-ink">@usuario.Email</p><p class="mt-0.5 text-xs text-ink-muted">ID: @Corto(usuario.UsuarioId)</p></td>
                                <td class="px-5 py-3">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var rol in usuario.Roles)
                                        {
                                            <span class="rounded-pill bg-surface-muted px-2 py-1 text-xs text-ink-muted">@EtiquetaRol(rol)</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-5 py-3"><span class="inline-flex rounded-pill px-2.5 py-1 text-xs font-medium @(usuario.IsActive ? "bg-brand-100 text-brand-700" : "bg-state-rechazada/10 text-state-rechazada")">@(usuario.IsActive ? "Activo" : "Inactivo")</span></td>
                                <td class="px-5 py-3">
                                    <div class="flex justify-end gap-1">
                                        @if (esStaffEditable)
                                        {
                                            <Button Variant="ButtonVariant.Ghost" Size="sm" IconName="key" Disabled="@procesando" OnClick="() => EditarRoles(usuario)">Roles</Button>
                                        }
                                        <Button Variant="ButtonVariant.Ghost" Size="sm" IconName="@(usuario.IsActive ? "lock" : "unlock")"
                                                Loading="@(procesando && usuarioProcesando == usuario.UsuarioId)"
                                                Disabled="@(procesando || NoPuedeDesactivar(usuario))"
                                                OnClick="() => CambiarEstadoAsync(usuario)">@(usuario.IsActive ? "Desactivar" : "Activar")</Button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>
</div>

<UsuarioAdminModal IsOpen="modalAbierto" IsOpenChanged="@(v => modalAbierto = v)" Usuario="usuarioEdicion" OnGuardado="CargarAsync" />

@code {
    private bool cargando = true;
    private string? error;
    private string busqueda = string.Empty;
    private string rolFiltro = string.Empty;
    private string estadoFiltro = string.Empty;
    private IReadOnlyList<UsuarioAdminDto> usuarios = [];
    private bool modalAbierto;
    private UsuarioAdminDto? usuarioEdicion;
    private bool procesando;
    private Guid? usuarioProcesando;

    private int TotalUsuarios => usuarios.Count;
    private int UsuariosActivos => usuarios.Count(x => x.IsActive);
    private int Administradores => usuarios.Count(x => x.Roles.Contains(Roles.Administrador));
    private int Secretarias => usuarios.Count(x => x.Roles.Contains(Roles.Secretaria));

    private IReadOnlyList<UsuarioAdminDto> Filtrados => usuarios
        .Where(x => string.IsNullOrWhiteSpace(busqueda) || x.Email.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(rolFiltro) || x.Roles.Contains(rolFiltro))
        .Where(x => estadoFiltro switch { "activo" => x.IsActive, "inactivo" => !x.IsActive, _ => true })
        .OrderByDescending(x => x.IsActive)
        .ThenBy(x => x.Email)
        .ToList();

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        cargando = usuarios.Count == 0;
        try { usuarios = await AdminApi.ListarUsuariosAsync(); error = null; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { error = ex.Message; }
        finally { cargando = false; }
    }

    private void NuevoUsuario() { usuarioEdicion = null; modalAbierto = true; }
    private void EditarRoles(UsuarioAdminDto usuario) { usuarioEdicion = usuario; modalAbierto = true; }

    private async Task CambiarEstadoAsync(UsuarioAdminDto usuario)
    {
        var activar = !usuario.IsActive;
        var ok = await Confirmar.ConfirmarAsync(
            $"¿Deseas {(activar ? "activar" : "desactivar")} el acceso de {usuario.Email}?",
            "Cambiar acceso", activar ? "Activar" : "Desactivar", !activar);
        if (!ok) return;

        procesando = true;
        usuarioProcesando = usuario.UsuarioId;
        try
        {
            var resultado = await AdminApi.ActualizarUsuarioAsync(usuario.UsuarioId, activar);
            if (!resultado.Exito)
            {
                Toast.Error(resultado.Error ?? "No fue posible actualizar el usuario.");
                return;
            }

            Toast.Exito($"Usuario {(activar ? "activado" : "desactivado")}.");
            await CargarAsync();
        }
        finally
        {
            procesando = false;
            usuarioProcesando = null;
        }
    }

    private static bool EsStaffEditable(UsuarioAdminDto usuario) =>
        usuario.Roles.Any(r => r == Roles.Administrador || r == Roles.Secretaria)
        && !usuario.Roles.Any(r => r == Roles.Medico || r == Roles.Paciente);

    private static bool NoPuedeDesactivar(UsuarioAdminDto usuario) =>
        usuario.IsActive && usuario.Roles.Contains(Roles.Administrador);

    private static string Corto(Guid id) => id.ToString()[..8];
    private static string EtiquetaRol(string rol) => rol switch { "Secretaria" => "Secretaría", "Medico" => "Médico", _ => rol };
}
