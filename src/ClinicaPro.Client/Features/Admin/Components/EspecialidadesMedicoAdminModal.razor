@inject AdminApiService AdminApi
@inject ToastService Toast
@inject ConfirmDialogService Confirmar

<Modal IsOpen="IsOpen" IsOpenChanged="CambiarApertura" Title="Especialidades del médico" IconName="stethoscope" MaxWidthClass="max-w-2xl" CloseOnBackdrop="false">
    <Body>
        @if (Medico is not null)
        {
            <div class="space-y-4">
                <div class="rounded-control bg-brand-50 px-3 py-2 text-sm text-brand-700">
                    <strong>@Medico.NombreCompleto</strong> · administra sus asociaciones clínicas.
                </div>

                @if (cargando)
                {
                    <Skeleton Filas="3" />
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var item in relaciones.OrderByDescending(x => x.EsPrimario).ThenByDescending(x => x.IsActive).ThenBy(x => x.Nombre))
                        {
                            <div class="flex flex-col gap-2 rounded-control border border-border p-3 sm:flex-row sm:items-center sm:justify-between">
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <p class="text-sm font-medium text-ink">@item.Nombre</p>
                                        @if (item.EsPrimario)
                                        {
                                            <span class="rounded-pill bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700">Primaria</span>
                                        }
                                        @if (!item.IsActive)
                                        {
                                            <span class="rounded-pill bg-state-rechazada/10 px-2 py-0.5 text-xs font-medium text-state-rechazada">Inactiva</span>
                                        }
                                    </div>
                                </div>
                                <div class="flex flex-wrap justify-end gap-1">
                                    @if (item.IsActive && !item.EsPrimario)
                                    {
                                        <Button Variant="ButtonVariant.Ghost" Size="sm" IconName="check" OnClick="() => HacerPrimariaAsync(item)">Hacer primaria</Button>
                                    }
                                    @if (item.IsActive)
                                    {
                                        <Button Variant="ButtonVariant.Ghost" Size="sm" IconName="trash" OnClick="() => QuitarAsync(item)">Quitar</Button>
                                    }
                                    else
                                    {
                                        <Button Variant="ButtonVariant.Ghost" Size="sm" IconName="unlock" OnClick="() => ReactivarAsync(item)">Reactivar</Button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="border-t border-border pt-3">
                        <p class="mb-2 text-sm font-medium text-ink">Agregar especialidad</p>
                        <div class="flex flex-col gap-2 sm:flex-row">
                            <select class="flex-1 rounded-control border border-border bg-surface px-3 py-2 text-sm text-ink" @bind="especialidadSeleccionada">
                                <option value="">Selecciona una especialidad</option>
                                @foreach (var item in Disponibles)
                                {
                                    <option value="@item.EspecialidadId">@item.Nombre</option>
                                }
                            </select>
                            <label class="flex items-center gap-2 text-sm text-ink">
                                <input type="checkbox" class="h-4 w-4 rounded border-border" @bind="nuevaPrimaria" /> Primaria
                            </label>
                            <Button Variant="ButtonVariant.Primary" Size="sm" IconName="plus" Loading="guardando" OnClick="AgregarAsync">Agregar</Button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="rounded-control bg-state-rechazada/10 px-3 py-2 text-sm text-state-rechazada">@error</p>
                }
            </div>
        }
    </Body>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="Cerrar">Cerrar</Button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public AdminMedicoDto? Medico { get; set; }
    [Parameter] public IReadOnlyList<EspecialidadAdminItem> Catalogo { get; set; } = [];
    [Parameter] public EventCallback OnGuardado { get; set; }

    private IReadOnlyList<MedicoEspecialidadAdminDto> relaciones = [];
    private bool cargando;
    private bool guardando;
    private bool aperturaAnterior;
    private Guid? medicoAnterior;
    private string especialidadSeleccionada = string.Empty;
    private bool nuevaPrimaria;
    private string? error;

    private IReadOnlyList<EspecialidadAdminItem> Disponibles
    {
        get
        {
            var activas = relaciones.Where(x => x.IsActive).Select(x => x.EspecialidadId).ToHashSet();
            return Catalogo.Where(x => x.IsActive && !activas.Contains(x.EspecialidadId)).OrderBy(x => x.Nombre).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Medico is not null && (!aperturaAnterior || medicoAnterior != Medico.MedicoId))
        {
            medicoAnterior = Medico.MedicoId;
            especialidadSeleccionada = string.Empty;
            nuevaPrimaria = false;
            error = null;
            await CargarAsync();
        }
        aperturaAnterior = IsOpen;
    }

    private async Task CargarAsync()
    {
        if (Medico is null) return;
        cargando = true;
        try
        {
            relaciones = await AdminApi.ListarEspecialidadesMedicoAsync(Medico.MedicoId);
            error = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            error = "No fue posible cargar las especialidades del médico.";
        }
        finally { cargando = false; }
    }

    private async Task AgregarAsync()
    {
        if (Medico is null || !Guid.TryParse(especialidadSeleccionada, out var id))
        {
            error = "Selecciona una especialidad.";
            return;
        }

        var inactiva = relaciones.FirstOrDefault(x => x.EspecialidadId == id && !x.IsActive);
        guardando = true;
        try
        {
            var resultado = inactiva is null
                ? await AdminApi.AgregarEspecialidadMedicoAsync(Medico.MedicoId, new AsignarEspecialidadMedicoRequest(id, nuevaPrimaria))
                : await AdminApi.ActualizarEspecialidadMedicoAsync(Medico.MedicoId, id, new ActualizarEspecialidadMedicoRequest(nuevaPrimaria, true));
            if (!resultado.Exito) { error = resultado.Error; return; }
            Toast.Exito("Especialidad asignada correctamente.");
            especialidadSeleccionada = string.Empty;
            nuevaPrimaria = false;
            await CargarAsync();
            await OnGuardado.InvokeAsync();
        }
        finally { guardando = false; }
    }

    private async Task HacerPrimariaAsync(MedicoEspecialidadAdminDto item)
    {
        if (Medico is null) return;
        var resultado = await AdminApi.ActualizarEspecialidadMedicoAsync(
            Medico.MedicoId, item.EspecialidadId, new ActualizarEspecialidadMedicoRequest(true, true));
        if (!resultado.Exito) { Toast.Error(resultado.Error ?? "No fue posible actualizar la especialidad."); return; }
        Toast.Exito("Especialidad primaria actualizada.");
        await CargarAsync();
        await OnGuardado.InvokeAsync();
    }

    private async Task QuitarAsync(MedicoEspecialidadAdminDto item)
    {
        if (Medico is null) return;
        var ok = await Confirmar.ConfirmarAsync(
            $"¿Deseas quitar {item.Nombre} de {Medico.NombreCompleto}?",
            "Quitar especialidad", "Quitar", true);
        if (!ok) return;

        var resultado = await AdminApi.QuitarEspecialidadMedicoAsync(Medico.MedicoId, item.EspecialidadId);
        if (!resultado.Exito) { Toast.Error(resultado.Error ?? "No fue posible quitar la especialidad."); return; }
        Toast.Exito("Especialidad quitada correctamente.");
        await CargarAsync();
        await OnGuardado.InvokeAsync();
    }

    private async Task ReactivarAsync(MedicoEspecialidadAdminDto item)
    {
        if (Medico is null) return;
        var resultado = await AdminApi.ActualizarEspecialidadMedicoAsync(
            Medico.MedicoId, item.EspecialidadId, new ActualizarEspecialidadMedicoRequest(false, true));
        if (!resultado.Exito) { Toast.Error(resultado.Error ?? "No fue posible reactivar la especialidad."); return; }
        Toast.Exito("Especialidad reactivada.");
        await CargarAsync();
        await OnGuardado.InvokeAsync();
    }

    private Task Cerrar() => IsOpenChanged.InvokeAsync(false);
    private Task CambiarApertura(bool valor) => IsOpenChanged.InvokeAsync(valor);
}
