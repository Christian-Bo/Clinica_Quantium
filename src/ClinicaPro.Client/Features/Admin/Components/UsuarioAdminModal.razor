@inject AdminApiService AdminApi
@inject ToastService Toast
@inject ConfirmDialogService Confirmar

<Modal IsOpen="IsOpen" IsOpenChanged="CambiarApertura" Title="@Titulo" IconName="users" MaxWidthClass="max-w-lg" CloseOnBackdrop="false">
    <Body>
        <div class="space-y-4">
            @if (Usuario is null)
            {
                <div class="rounded-control border border-brand-200 bg-brand-50 px-3 py-2 text-xs text-brand-700">
                    Crea aquí cuentas para Secretaría o Administración. Los médicos se registran desde la sección Médicos y horarios.
                </div>

                <ValidatedTextInput Id="usr-email" Label="Correo" Required="true" Kind="FormFieldKind.Email"
                                    Value="@email" ValueChanged="v => email = v" Placeholder="Ej. secretaria@clinicapro.com"
                                    Autocomplete="email" MaxLength="254" HelperText="Este correo será el nombre de usuario."
                                    ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <PasswordField Id="usr-password" Label="Contraseña temporal"
                               Value="@password" ValueChanged="v => password = v"
                               Placeholder="Ej. Acceso@2026" ShowRules="true"
                               ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <div>
                    <label class="text-sm font-medium text-ink" for="usr-rol">Tipo de acceso <span class="text-state-rechazada">*</span></label>
                    <select id="usr-rol" class="@ClaseInput" @bind="rolCrear">
                        <option value="Secretaria">Secretaría</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                    <p class="mt-1 text-xs text-ink-muted">Secretaría gestiona citas y pacientes; Administración también puede gestionar usuarios y ajustes.</p>
                </div>
            }
            else if (EsIdentidad)
            {
                <p class="text-xs text-ink-muted">Actualiza el correo, la contraseña o el estado de la cuenta. Si cambias el acceso, el usuario deberá iniciar sesión nuevamente.</p>

                <ValidatedTextInput Id="usr-edit-email" Label="Correo" Required="true" Kind="FormFieldKind.Email"
                                    Value="@email" ValueChanged="v => email = v" Placeholder="Ej. usuario@clinicapro.com"
                                    Autocomplete="email" MaxLength="254" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <PasswordField Id="usr-edit-password" Label="Nueva contraseña"
                               Value="@password" ValueChanged="v => password = v"
                               Placeholder="Déjala vacía para conservar la actual" Required="false" ShowRules="true"
                               HelperText="Si defines una nueva clave, el usuario deberá cambiarla al iniciar sesión."
                               ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <label class="flex items-center gap-2 rounded-control border border-border px-3 py-3 text-sm text-ink">
                    <input type="checkbox" class="h-4 w-4 rounded border-border" @bind="isActive" /> Cuenta activa
                </label>
            }
            else
            {
                <div class="rounded-control bg-surface-muted px-3 py-2 text-sm text-ink">
                    <strong>@Usuario.Email</strong>
                    <p class="mt-0.5 text-xs text-ink-muted">Una cuenta puede ser médico o paciente, pero no ambos. Si cambias este perfil, el usuario deberá iniciar sesión nuevamente.</p>
                </div>

                <section class="space-y-2" aria-labelledby="roles-acceso-titulo">
                    <div>
                        <p id="roles-acceso-titulo" class="text-sm font-semibold text-ink">Permisos de acceso</p>
                        <p class="mt-0.5 text-xs text-ink-muted">Puedes habilitar Administración, Secretaría o ambos accesos.</p>
                    </div>
                    <label class="flex items-center gap-2 rounded-control border border-border px-3 py-3 text-sm text-ink">
                        <input type="checkbox" class="h-4 w-4 rounded border-border" @bind="rolAdministrador" /> Administrador
                    </label>
                    <label class="flex items-center gap-2 rounded-control border border-border px-3 py-3 text-sm text-ink">
                        <input type="checkbox" class="h-4 w-4 rounded border-border" @bind="rolSecretaria" /> Secretaría
                    </label>
                </section>

                <section class="space-y-2 border-t border-border pt-4" aria-labelledby="tipo-clinico-titulo">
                    <div>
                        <label id="tipo-clinico-titulo" class="text-sm font-semibold text-ink" for="usr-tipo-clinico">Perfil en la clínica</label>
                        <p class="mt-0.5 text-xs text-ink-muted">Selecciona si esta cuenta corresponde a un médico, a un paciente o a ninguno.</p>
                    </div>
                    <select id="usr-tipo-clinico" class="@ClaseInput" @bind="tipoClinico">
                        <option value="Ninguno">Ninguno</option>
                        <option value="Medico">Médico</option>
                        <option value="Paciente">Paciente</option>
                    </select>
                </section>

                @if (RequiereFichaClinica && tipoClinico == "Medico")
                {
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <ValidatedTextInput Id="usr-med-nombres" Label="Nombres" Required="true" Kind="FormFieldKind.Name"
                                            Value="@medicoNombres" ValueChanged="v => medicoNombres = v" Placeholder="Ej. Ana Lucía"
                                            Autocomplete="given-name" MaxLength="100" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                        <ValidatedTextInput Id="usr-med-apellidos" Label="Apellidos" Required="true" Kind="FormFieldKind.Name"
                                            Value="@medicoApellidos" ValueChanged="v => medicoApellidos = v" Placeholder="Ej. Morales Pérez"
                                            Autocomplete="family-name" MaxLength="100" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                        <ValidatedTextInput Id="usr-med-colegiado" Label="No. colegiado" Required="true" Kind="FormFieldKind.Collegiate"
                                            Value="@medicoColegiado" ValueChanged="v => medicoColegiado = v" Placeholder="Ej. 15422"
                                            MaxLength="50" HelperText="Necesario para registrar al médico." ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                        <ValidatedTextInput Id="usr-med-telefono" Label="Teléfono" Kind="FormFieldKind.GuatemalaPhone"
                                            Value="@medicoTelefono" ValueChanged="v => medicoTelefono = v" Placeholder="55123456"
                                            Autocomplete="tel-national" HelperText="8 dígitos; +502 se agrega automáticamente."
                                            ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                    </div>
                }

                @if (RequiereFichaClinica && tipoClinico == "Paciente")
                {
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <ValidatedTextInput Id="usr-pac-nombres" Label="Nombres" Required="true" Kind="FormFieldKind.Name"
                                            Value="@pacienteNombres" ValueChanged="v => pacienteNombres = v" Placeholder="Ej. María José"
                                            Autocomplete="given-name" MaxLength="100" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                        <ValidatedTextInput Id="usr-pac-apellidos" Label="Apellidos" Required="true" Kind="FormFieldKind.Name"
                                            Value="@pacienteApellidos" ValueChanged="v => pacienteApellidos = v" Placeholder="Ej. López García"
                                            Autocomplete="family-name" MaxLength="100" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                        <ValidatedTextInput Id="usr-pac-dpi" Label="DPI / CUI" Required="true" Kind="FormFieldKind.Dpi"
                                            Value="@pacienteDocumento" ValueChanged="v => pacienteDocumento = v" Placeholder="Ej. 1234567890101"
                                            HelperText="Debe contener exactamente 13 dígitos." ForceTouched="mostrarValidaciones"
                                            ValidationCycle="cicloValidacion" CssClass="sm:col-span-2" />
                        <ValidatedTextInput Id="usr-pac-telefono" Label="Teléfono" Kind="FormFieldKind.GuatemalaPhone"
                                            Value="@pacienteTelefono" ValueChanged="v => pacienteTelefono = v" Placeholder="55123456"
                                            Autocomplete="tel-national" HelperText="Opcional. 8 dígitos; +502 se agrega automáticamente."
                                            ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" CssClass="sm:col-span-2" />
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="rounded-control bg-state-rechazada/10 px-3 py-2 text-sm text-state-rechazada">@error</p>
            }
        </div>
    </Body>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" Disabled="guardando" OnClick="Cancelar">Cancelar</Button>
        <Button Variant="ButtonVariant.Primary" Loading="guardando" IconName="check" OnClick="GuardarAsync">Guardar</Button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public UsuarioAdminDto? Usuario { get; set; }
    [Parameter] public string Modo { get; set; } = "roles";
    [Parameter] public EventCallback OnGuardado { get; set; }

    private const string ClaseInput = "mt-1 w-full rounded-control border border-border bg-surface px-3 py-2.5 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100";
    private bool aperturaAnterior;
    private Guid? usuarioAnterior;
    private string modoAnterior = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string rolCrear = Roles.Secretaria;
    private bool rolAdministrador;
    private bool rolSecretaria;
    private bool isActive = true;
    private string tipoClinico = "Ninguno";
    private string tipoClinicoOriginal = "Ninguno";
    private string medicoNombres = string.Empty;
    private string medicoApellidos = string.Empty;
    private string medicoColegiado = string.Empty;
    private string medicoTelefono = string.Empty;
    private string pacienteNombres = string.Empty;
    private string pacienteApellidos = string.Empty;
    private string pacienteDocumento = string.Empty;
    private string pacienteTelefono = string.Empty;
    private bool guardando;
    private string? error;
    private bool mostrarValidaciones;
    private int cicloValidacion;

    private bool EsIdentidad => Usuario is not null && Modo == "identidad";
    private bool RequiereFichaClinica => Usuario is not null
        && !string.Equals(tipoClinico, tipoClinicoOriginal, StringComparison.Ordinal)
        && tipoClinico is "Medico" or "Paciente";
    private string Titulo => Usuario is null ? "Nuevo usuario" : EsIdentidad ? "Editar usuario" : "Editar permisos";

    protected override void OnParametersSet()
    {
        if (IsOpen && (!aperturaAnterior || usuarioAnterior != Usuario?.UsuarioId || modoAnterior != Modo))
        {
            email = Usuario?.Email ?? string.Empty;
            password = string.Empty;
            rolCrear = Roles.Secretaria;
            rolAdministrador = Usuario?.Roles.Contains(Roles.Administrador) == true;
            rolSecretaria = Usuario?.Roles.Contains(Roles.Secretaria) == true;
            isActive = Usuario?.IsActive != false;
            tipoClinico = Usuario is null
                ? "Ninguno"
                : Usuario.Roles.Contains(Roles.Medico) ? "Medico"
                : Usuario.Roles.Contains(Roles.Paciente) ? "Paciente"
                : "Ninguno";
            tipoClinicoOriginal = tipoClinico;
            medicoNombres = string.Empty;
            medicoApellidos = string.Empty;
            medicoColegiado = string.Empty;
            medicoTelefono = string.Empty;
            pacienteNombres = string.Empty;
            pacienteApellidos = string.Empty;
            pacienteDocumento = string.Empty;
            pacienteTelefono = string.Empty;
            error = null;
            mostrarValidaciones = false;
            cicloValidacion++;
            usuarioAnterior = Usuario?.UsuarioId;
            modoAnterior = Modo;
        }

        aperturaAnterior = IsOpen;
    }

    private bool ValidarFormulario()
    {
        if (Usuario is null)
        {
            return FormValidation.Validate(FormFieldKind.Email, email, true, 254, "Correo") is null
                && FormValidation.IsPasswordValid(password);
        }

        if (EsIdentidad)
        {
            return FormValidation.Validate(FormFieldKind.Email, email, true, 254, "Correo") is null
                && (string.IsNullOrWhiteSpace(password) || FormValidation.IsPasswordValid(password));
        }

        if (!rolAdministrador && !rolSecretaria && tipoClinico == "Ninguno")
        {
            error = "Selecciona al menos un permiso de acceso o un perfil en la clínica.";
            return false;
        }

        if (RequiereFichaClinica && tipoClinico == "Medico")
        {
            if (FormValidation.Validate(FormFieldKind.Name, medicoNombres, true, 100, "Nombres") is not null) return false;
            if (FormValidation.Validate(FormFieldKind.Name, medicoApellidos, true, 100, "Apellidos") is not null) return false;
            if (FormValidation.Validate(FormFieldKind.Collegiate, medicoColegiado, true, 50, "No. colegiado") is not null) return false;
            if (!string.IsNullOrWhiteSpace(medicoTelefono)
                && FormValidation.Validate(FormFieldKind.GuatemalaPhone, medicoTelefono, false) is not null) return false;
        }
        else if (RequiereFichaClinica && tipoClinico == "Paciente")
        {
            if (FormValidation.Validate(FormFieldKind.Name, pacienteNombres, true, 100, "Nombres") is not null) return false;
            if (FormValidation.Validate(FormFieldKind.Name, pacienteApellidos, true, 100, "Apellidos") is not null) return false;
            if (FormValidation.Validate(FormFieldKind.Dpi, pacienteDocumento, true, FormValidation.DpiLength, "DPI / CUI") is not null) return false;
            if (!string.IsNullOrWhiteSpace(pacienteTelefono)
                && FormValidation.Validate(FormFieldKind.GuatemalaPhone, pacienteTelefono, false) is not null) return false;
        }

        return true;
    }

    private async Task GuardarAsync()
    {
        if (guardando) return;

        error = null;
        mostrarValidaciones = true;
        if (!ValidarFormulario()) return;

        if (Usuario is not null && !EsIdentidad)
        {
            var accesos = new List<string>();
            if (rolAdministrador) accesos.Add("Administrador");
            if (rolSecretaria) accesos.Add("Secretaría");
            var accesoTexto = accesos.Count == 0 ? "sin permisos administrativos" : string.Join(" + ", accesos);
            var tipoTexto = tipoClinico switch { "Medico" => "Médico", "Paciente" => "Paciente", _ => "Ninguno" };
            var confirmar = await Confirmar.ConfirmarAsync(
                $"Se aplicarán estos cambios: {accesoTexto}; perfil {tipoTexto}. El usuario deberá iniciar sesión nuevamente.",
                titulo: "Confirmar cambios",
                textoConfirmar: "Aplicar cambios");
            if (!confirmar) return;
        }

        guardando = true;
        try
        {
            if (Usuario is null)
            {
                var resultado = await AdminApi.CrearUsuarioAsync(
                    new CrearUsuarioStaffRequest(FormValidation.NormalizeEmail(email), password, rolCrear));

                if (!resultado.Exito)
                {
                    error = resultado.Error;
                    return;
                }

                Toast.Exito("Usuario creado. Deberá cambiar su contraseña temporal al iniciar sesión.");
            }
            else if (EsIdentidad)
            {
                var resultado = await AdminApi.ActualizarUsuarioAsync(
                    Usuario.UsuarioId,
                    isActive,
                    FormValidation.NormalizeEmail(email),
                    string.IsNullOrWhiteSpace(password) ? null : password);

                if (!resultado.Exito)
                {
                    error = resultado.Error;
                    return;
                }

                Toast.Exito("Usuario actualizado. Si cambió la clave, deberá volver a entrar.");
            }
            else
            {
                var roles = new List<string>();
                if (rolAdministrador) roles.Add(Roles.Administrador);
                if (rolSecretaria) roles.Add(Roles.Secretaria);

                FichaMedicoAccesoRequest? medico = null;
                FichaPacienteAccesoRequest? paciente = null;

                if (RequiereFichaClinica && tipoClinico == "Medico")
                {
                    medico = new FichaMedicoAccesoRequest(
                        FormValidation.NormalizeName(medicoNombres),
                        FormValidation.NormalizeName(medicoApellidos),
                        Limpio(medicoColegiado),
                        FormValidation.ToApiGuatemalaPhone(medicoTelefono));
                }
                else if (RequiereFichaClinica && tipoClinico == "Paciente")
                {
                    paciente = new FichaPacienteAccesoRequest(
                        FormValidation.NormalizeName(pacienteNombres),
                        FormValidation.NormalizeName(pacienteApellidos),
                        FormValidation.NormalizeDpi(pacienteDocumento),
                        null,
                        FormValidation.ToApiGuatemalaPhone(pacienteTelefono));
                }

                var resultado = await AdminApi.ActualizarRolesAsync(Usuario.UsuarioId, roles, tipoClinico, medico, paciente);
                if (!resultado.Exito)
                {
                    error = resultado.Error;
                    return;
                }

                Toast.Exito("Permisos actualizados. El usuario deberá iniciar sesión nuevamente.");
            }

            await OnGuardado.InvokeAsync();
            await IsOpenChanged.InvokeAsync(false);
        }
        finally
        {
            guardando = false;
        }
    }

    private Task Cancelar() => IsOpenChanged.InvokeAsync(false);
    private Task CambiarApertura(bool valor) => IsOpenChanged.InvokeAsync(valor);
    private static string? Limpio(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
}
