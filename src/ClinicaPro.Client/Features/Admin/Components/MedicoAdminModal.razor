@inject AdminApiService AdminApi
@inject ToastService Toast

<Modal IsOpen="IsOpen" IsOpenChanged="CambiarApertura" Title="@Titulo" IconName="stethoscope" MaxWidthClass="max-w-2xl" CloseOnBackdrop="false">
    <Body>
        <EditForm EditContext="editContext">
            <DataAnnotationsValidator />
            <div class="space-y-5">
                @if (!EsEdicion)
                {
                    <div class="rounded-control border border-brand-200 bg-brand-50 px-4 py-3">
                        <div class="flex items-start gap-3">
                            <Icon Name="key" Size="18" CssClass="mt-0.5 text-brand-600" />
                            <div>
                                <p class="text-sm font-semibold text-brand-700">Cuenta de acceso médica</p>
                                <p class="mt-1 text-xs leading-5 text-brand-700">Se crea la cuenta del médico en un solo paso. La contraseña es temporal y deberá cambiarla al ingresar por primera vez.</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <ValidatedTextInput Id="med-email" Label="Correo electrónico" Required="true" Kind="FormFieldKind.Email"
                                        Value="@modelo.Email" ValueChanged="v => modelo.Email = v" Placeholder="Ej. carlos.perez@clinicapro.com"
                                        Autocomplete="email" MaxLength="254"
                                        HelperText="@(EsEdicion ? "Si cambias el correo, el médico deberá usar el nuevo correo para iniciar sesión." : "Será el usuario de acceso del médico.")"
                                        ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" CssClass="sm:col-span-2" />

                    <PasswordField Id="med-password" Label="@(EsEdicion ? "Nueva contraseña" : "Contraseña temporal")"
                                   Value="@modelo.Password" ValueChanged="v => modelo.Password = v"
                                   Placeholder="@(EsEdicion ? "Déjala vacía para conservar la actual" : "Ej. Medico@2026")"
                                   Required="@(!EsEdicion)" ShowRules="true"
                                   HelperText="@(EsEdicion ? "Si defines una nueva clave, el médico deberá volver a iniciar sesión." : string.Empty)"
                                   ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" CssClass="sm:col-span-2" />

                    <ValidatedTextInput Id="med-nombres" Label="Nombres" Required="true" Kind="FormFieldKind.Name"
                                        Value="@modelo.Nombres" ValueChanged="v => modelo.Nombres = v" Placeholder="Ej. Carlos Eduardo"
                                        Autocomplete="given-name" MaxLength="100" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                    <ValidatedTextInput Id="med-apellidos" Label="Apellidos" Required="true" Kind="FormFieldKind.Name"
                                        Value="@modelo.Apellidos" ValueChanged="v => modelo.Apellidos = v" Placeholder="Ej. Pérez López"
                                        Autocomplete="family-name" MaxLength="100" ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                    <ValidatedTextInput Id="med-colegiado" Label="No. colegiado" Required="true" Kind="FormFieldKind.Collegiate"
                                        Value="@modelo.NumeroColegiado" ValueChanged="v => modelo.NumeroColegiado = v" Placeholder="Ej. 15422"
                                        MaxLength="50" HelperText="Obligatorio. Usa el número registrado por el colegio profesional."
                                        ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />
                    <ValidatedTextInput Id="med-telefono" Label="Teléfono" Kind="FormFieldKind.GuatemalaPhone"
                                        Value="@modelo.Telefono" ValueChanged="v => modelo.Telefono = v" Placeholder="55123456"
                                        Autocomplete="tel-national" HelperText="8 dígitos; +502 se agrega automáticamente."
                                        ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                    @if (EsEdicion)
                    {
                        <div class="sm:col-span-2 rounded-control border border-border bg-surface-muted px-4 py-3">
                            <label class="flex items-start gap-3 text-sm text-ink">
                                <input type="checkbox" class="mt-0.5 h-4 w-4 rounded border-border" @bind="modelo.IsActive" />
                                <span>
                                    <span class="font-medium">Médico activo</span>
                                    <span class="mt-0.5 block text-xs text-ink-muted">Un médico inactivo deja de aparecer para nuevas citas, pero conserva su historial.</span>
                                </span>
                            </label>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="rounded-control bg-state-rechazada/10 px-3 py-2 text-sm text-state-rechazada">@error</p>
                }
            </div>
        </EditForm>
    </Body>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" Disabled="guardando" OnClick="Cancelar">Cancelar</Button>
        <Button Variant="ButtonVariant.Primary" Loading="guardando" IconName="check" OnClick="GuardarAsync">@(EsEdicion ? "Guardar cambios" : "Crear médico")</Button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public AdminMedicoDto? Medico { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }

    private Modelo modelo = new();
    private EditContext editContext = new(new Modelo());
    private bool guardando;
    private string? error;
    private bool aperturaAnterior;
    private Guid? idAnterior;
    private bool mostrarValidaciones;
    private int cicloValidacion;

    private bool EsEdicion => Medico is not null;
    private string Titulo => EsEdicion ? "Editar médico" : "Nuevo médico";

    protected override void OnParametersSet()
    {
        if (IsOpen && (!aperturaAnterior || idAnterior != Medico?.MedicoId))
        {
            modelo = Medico is null
                ? new Modelo()
                : new Modelo
                {
                    Email = Medico.Email,
                    Nombres = Medico.Nombres,
                    Apellidos = Medico.Apellidos,
                    NumeroColegiado = Medico.NumeroColegiado ?? string.Empty,
                    Telefono = FormValidation.FromApiGuatemalaPhone(Medico.Telefono),
                    IsActive = Medico.IsActive
                };

            editContext = new EditContext(modelo);
            error = null;
            mostrarValidaciones = false;
            cicloValidacion++;
            idAnterior = Medico?.MedicoId;
        }

        aperturaAnterior = IsOpen;
    }

    private bool ValidacionLocal()
    {
        if (FormValidation.Validate(FormFieldKind.Email, modelo.Email, true, 254, "Correo electrónico") is not null) return false;
        if (FormValidation.Validate(FormFieldKind.Name, modelo.Nombres, true, 100, "Nombres") is not null) return false;
        if (FormValidation.Validate(FormFieldKind.Name, modelo.Apellidos, true, 100, "Apellidos") is not null) return false;
        if (FormValidation.Validate(FormFieldKind.Collegiate, modelo.NumeroColegiado, true, 50, "No. colegiado") is not null) return false;
        if (!string.IsNullOrWhiteSpace(modelo.Telefono)
            && FormValidation.Validate(FormFieldKind.GuatemalaPhone, modelo.Telefono, false) is not null) return false;
        if (!EsEdicion && !FormValidation.IsPasswordValid(modelo.Password)) return false;
        if (EsEdicion && !string.IsNullOrWhiteSpace(modelo.Password) && !FormValidation.IsPasswordValid(modelo.Password)) return false;
        return true;
    }

    private async Task GuardarAsync()
    {
        if (guardando) return;

        mostrarValidaciones = true;
        error = null;
        if (!ValidacionLocal() || !editContext.Validate()) return;

        guardando = true;
        try
        {
            if (EsEdicion)
            {
                var resultado = await AdminApi.ActualizarMedicoAsync(
                    Medico!.MedicoId,
                    new ActualizarMedicoRequest(
                        FormValidation.NormalizeName(modelo.Nombres),
                        FormValidation.NormalizeName(modelo.Apellidos),
                        Limpio(modelo.NumeroColegiado),
                        FormValidation.ToApiGuatemalaPhone(modelo.Telefono),
                        modelo.IsActive,
                        FormValidation.NormalizeEmail(modelo.Email),
                        string.IsNullOrWhiteSpace(modelo.Password) ? null : modelo.Password));

                if (!resultado.Exito)
                {
                    error = resultado.Error;
                    return;
                }

                Toast.Exito("Médico actualizado correctamente.");
            }
            else
            {
                var resultado = await AdminApi.CrearMedicoAsync(
                    new CrearMedicoRequest(
                        FormValidation.NormalizeEmail(modelo.Email),
                        modelo.Password,
                        FormValidation.NormalizeName(modelo.Nombres),
                        FormValidation.NormalizeName(modelo.Apellidos),
                        Limpio(modelo.NumeroColegiado),
                        FormValidation.ToApiGuatemalaPhone(modelo.Telefono)));

                if (!resultado.Exito)
                {
                    error = resultado.Error;
                    return;
                }

                Toast.Exito("Médico creado. Deberá cambiar su contraseña temporal al ingresar.");
            }

            await OnGuardado.InvokeAsync();
            await IsOpenChanged.InvokeAsync(false);
        }
        finally
        {
            guardando = false;
        }
    }

    private Task Cancelar() => IsOpenChanged.InvokeAsync(false);
    private Task CambiarApertura(bool valor) => IsOpenChanged.InvokeAsync(valor);
    private static string? Limpio(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private sealed class Modelo
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        [Required, StringLength(100)] public string Nombres { get; set; } = string.Empty;
        [Required, StringLength(100)] public string Apellidos { get; set; } = string.Empty;
        public string NumeroColegiado { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }
}
