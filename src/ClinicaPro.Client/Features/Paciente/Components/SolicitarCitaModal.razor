@inject CitasPacienteApiService CitasApi

<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Title="Solicitar una cita" IconName="calendar" MaxWidthClass="max-w-2xl" CloseOnBackdrop="false">
    <Body>
        <div class="space-y-5">
            <div class="rounded-control border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-700">
                Elige una fecha y después selecciona directamente al médico y la hora disponible. La solicitud quedará pendiente de confirmación por Secretaría.
            </div>

            <div>
                <label class="text-sm font-medium text-ink" for="sc-fecha">Fecha *</label>
                <input id="sc-fecha" type="date" min="@MananaIso" class="@ClaseInput" value="@fechaTexto" @onchange="CambiarFecha" />
            </div>

            <div>
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="text-sm font-medium text-ink">Médico y horario *</p>
                        <p class="mt-0.5 text-xs text-ink-muted">Solo aparecen espacios realmente disponibles.</p>
                    </div>
                    @if (buscandoSlots)
                    {
                        <span class="text-xs text-ink-muted">Consultando...</span>
                    }
                </div>

                @if (buscandoSlots)
                {
                    <div class="mt-3"><Skeleton Filas="3" HeightClass="h-12" /></div>
                }
                else if (!string.IsNullOrEmpty(errorDisponibilidad))
                {
                    <p role="alert" class="mt-2 rounded-control bg-state-rechazada/10 px-3 py-2 text-sm text-state-rechazada">@errorDisponibilidad</p>
                }
                else if (slots.Count == 0)
                {
                    <p class="mt-2 rounded-control bg-surface-muted px-3 py-3 text-sm text-ink-muted">No hay horarios libres ese día. Prueba con otra fecha.</p>
                }
                else
                {
                    <div class="mt-3 space-y-3">
                        @foreach (var grupo in SlotsPorMedico)
                        {
                            <div class="rounded-control border border-border bg-surface-muted/50 p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="flex h-8 w-8 items-center justify-center rounded-pill bg-brand-100 text-brand-700"><Icon Name="stethoscope" Size="16" /></span>
                                    <div><p class="text-sm font-semibold text-ink">@grupo.Nombre</p><p class="text-xs text-ink-muted">@grupo.Slots.Count @(grupo.Slots.Count == 1 ? "horario" : "horarios")</p></div>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var slot in grupo.Slots)
                                    {
                                        <button type="button" class="@ClaseSlot(slot)" @onclick="() => slotElegido = slot" aria-pressed="@EsSlotElegido(slot)">
                                            @slot.FechaHoraInicio.ToString("HH:mm")
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (slotElegido is not null)
            {
                <div class="rounded-control border border-brand-200 bg-brand-50 px-3 py-3">
                    <p class="text-xs uppercase tracking-wide text-brand-600">Selección</p>
                    <p class="mt-1 text-sm font-semibold text-ink">@slotElegido.MedicoNombre</p>
                    <p class="mt-0.5 text-xs text-ink-muted">@slotElegido.FechaHoraInicio.ToString("dd/MM/yyyy") · @slotElegido.FechaHoraInicio.ToString("HH:mm") – @slotElegido.FechaHoraFin.ToString("HH:mm")</p>
                </div>
            }

            <div>
                <label class="text-sm font-medium text-ink" for="sc-motivo">Motivo de la consulta *</label>
                <textarea id="sc-motivo" rows="3" class="@ClaseInput" placeholder="Cuéntanos brevemente qué te trae a consulta" @bind="motivo" @bind:event="oninput"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <p role="alert" class="rounded-control bg-state-rechazada/10 px-3 py-2 text-sm text-state-rechazada">@error</p>
            }
        </div>
    </Body>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" Disabled="enviando" OnClick="Cerrar">Cancelar</Button>
        <Button Variant="ButtonVariant.Primary" Loading="enviando" OnClick="Solicitar">Solicitar cita</Button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<CitaDto> OnSolicitada { get; set; }

    private const string ClaseInput = "mt-1 w-full rounded-control border border-border px-3 py-2 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100";
    private static readonly string MananaIso = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");

    private List<SlotDisponibleDto> slots = [];
    private SlotDisponibleDto? slotElegido;
    private string fechaTexto = DateOnly.FromDateTime(DateTime.Today.AddDays(1)).ToString("yyyy-MM-dd");
    private string motivo = string.Empty;
    private string? error;
    private string? errorDisponibilidad;
    private bool buscandoSlots;
    private bool enviando;
    private bool isOpenAnterior;

    private IReadOnlyList<GrupoMedico> SlotsPorMedico => slots
        .GroupBy(x => new { x.MedicoId, x.MedicoNombre })
        .Select(g => new GrupoMedico(g.Key.MedicoId, g.Key.MedicoNombre, g.OrderBy(x => x.FechaHoraInicio).ToList()))
        .OrderBy(x => x.Nombre)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !isOpenAnterior)
        {
            Reiniciar();
            await BuscarSlots();
        }
        isOpenAnterior = IsOpen;
    }

    private void Reiniciar()
    {
        fechaTexto = DateOnly.FromDateTime(DateTime.Today.AddDays(1)).ToString("yyyy-MM-dd");
        motivo = string.Empty;
        slots = [];
        slotElegido = null;
        error = null;
        errorDisponibilidad = null;
    }

    private async Task CambiarFecha(ChangeEventArgs e)
    {
        fechaTexto = e.Value?.ToString() ?? string.Empty;
        await BuscarSlots();
    }

    private async Task BuscarSlots()
    {
        slotElegido = null;
        slots = [];
        errorDisponibilidad = null;
        if (!DateOnly.TryParse(fechaTexto, out var fecha)) return;

        buscandoSlots = true;
        var resultado = await CitasApi.ListarDisponibilidadAsync(fecha);
        buscandoSlots = false;

        if (resultado.Exito && resultado.Valor is not null)
        {
            slots = [.. resultado.Valor];
            return;
        }

        errorDisponibilidad = resultado.Error;
    }

    private bool EsSlotElegido(SlotDisponibleDto slot)
        => slotElegido is not null && slotElegido.FechaHoraInicio == slot.FechaHoraInicio && slotElegido.MedicoId == slot.MedicoId;

    private string ClaseSlot(SlotDisponibleDto slot) => EsSlotElegido(slot)
        ? "rounded-control border border-brand-500 bg-brand-500 px-3 py-2 text-sm font-semibold text-white"
        : "rounded-control border border-border bg-surface px-3 py-2 text-sm text-ink transition-colors hover:border-brand-500 hover:text-brand-600";

    private async Task Solicitar()
    {
        error = null;
        if (slotElegido is null)
        {
            error = "Elige un médico y uno de sus horarios disponibles.";
            return;
        }
        if (string.IsNullOrWhiteSpace(motivo))
        {
            error = "Cuéntanos el motivo de la consulta.";
            return;
        }

        enviando = true;
        var resultado = await CitasApi.SolicitarAsync(slotElegido.MedicoId, slotElegido.FechaHoraInicio, motivo.Trim());
        enviando = false;

        if (resultado.Exito && resultado.Valor is not null)
        {
            await OnSolicitada.InvokeAsync(resultado.Valor);
            await Cerrar();
            return;
        }

        error = resultado.Error ?? "No fue posible solicitar la cita.";
    }

    private Task Cerrar() => IsOpenChanged.InvokeAsync(false);
    private sealed record GrupoMedico(Guid MedicoId, string Nombre, IReadOnlyList<SlotDisponibleDto> Slots);
}
