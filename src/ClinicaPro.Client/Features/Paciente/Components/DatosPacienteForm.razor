@* Formulario reutilizable para registro y perfil. Los componentes compartidos
   mantienen la misma validación visual y normalización en todas las vistas. *@

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    @if (Muestra(SeccionFormulario.Cuenta) && MostrarCredenciales)
    {
        <ValidatedTextInput Id="dp-email" Label="Correo electrónico" Required="true" Kind="FormFieldKind.Email"
                            Value="@Modelo.Email" ValueChanged="v => Modelo.Email = v"
                            Placeholder="Ej. nombre@correo.com" Autocomplete="email" MaxLength="254"
                            HelperText="Con este correo vas a entrar al portal."
                            ForceTouched='@TieneError("Email")' ValidationCycle="ValidationCycle" CssClass="sm:col-span-2" />

        <PasswordField Id="dp-password" Label="Contraseña" Required="true"
                       Value="@Modelo.Password" ValueChanged="v => Modelo.Password = v"
                       Placeholder="Ej. Salud@2026" Autocomplete="new-password" ShowRules="true"
                       ForceTouched='@TieneError("Password")' ValidationCycle="ValidationCycle" />

        <PasswordField Id="dp-password-confirmacion" Label="Repetir contraseña" Required="true"
                       Value="@Modelo.PasswordConfirmacion" ValueChanged="v => Modelo.PasswordConfirmacion = v"
                       MatchValue="@Modelo.Password" ValidatePolicy="false" ValidateMatch="true"
                       Placeholder="Repite la contraseña" Autocomplete="new-password"
                       HelperText="Debe coincidir exactamente con la contraseña anterior."
                       ForceTouched='@TieneError("PasswordConfirmacion")' ValidationCycle="ValidationCycle" />
    }

    @if (Muestra(SeccionFormulario.DatosPersonales))
    {
        <ValidatedTextInput Id="dp-nombres" Label="Nombres" Required="true" Kind="FormFieldKind.Name"
                            Value="@Modelo.Nombres" ValueChanged="v => Modelo.Nombres = v"
                            Placeholder="Ej. María José" Autocomplete="given-name" MaxLength="100"
                            ForceTouched='@TieneError("Nombres")' ValidationCycle="ValidationCycle" />

        <ValidatedTextInput Id="dp-apellidos" Label="Apellidos" Required="true" Kind="FormFieldKind.Name"
                            Value="@Modelo.Apellidos" ValueChanged="v => Modelo.Apellidos = v"
                            Placeholder="Ej. López García" Autocomplete="family-name" MaxLength="100"
                            ForceTouched='@TieneError("Apellidos")' ValidationCycle="ValidationCycle" />

        <ValidatedTextInput Id="dp-documento" Label="DPI / CUI" Required="true" Kind="FormFieldKind.Dpi"
                            Value="@Modelo.Documento" ValueChanged="v => Modelo.Documento = v"
                            Placeholder="Ej. 3045291840101" Disabled="DocumentoSoloLectura"
                            HelperText="@(DocumentoSoloLectura ? "Si el DPI necesita corrección, solicítala en recepción." : "Debe contener exactamente 13 dígitos.")"
                            ForceTouched='@TieneError("Documento")' ValidationCycle="ValidationCycle" />

        <div>
            <label class="text-sm font-medium text-ink" for="dp-nacimiento">Fecha de nacimiento</label>
            <input id="dp-nacimiento" type="date" max="@HoyIso"
                   class="@ClaseInputNativo("FechaNacimiento")" @bind="Modelo.FechaNacimiento" />
            <MensajeCampo Mensaje='@Error("FechaNacimiento")' />
            <p class="mt-1 text-xs text-ink-muted">No puede ser una fecha futura.</p>
        </div>

        <div>
            <label class="text-sm font-medium text-ink" for="dp-sexo">Sexo</label>
            <select id="dp-sexo" class="@ClaseInputNativo("Sexo")" @bind="Modelo.Sexo">
                <option value="">Sin especificar</option>
                <option value="F">Femenino</option>
                <option value="M">Masculino</option>
                <option value="X">Otro</option>
            </select>
            <MensajeCampo Mensaje='@Error("Sexo")' />
        </div>

        <ValidatedTextInput Id="dp-telefono" Label="Teléfono" Kind="FormFieldKind.GuatemalaPhone"
                            Value="@Modelo.Telefono" ValueChanged="v => Modelo.Telefono = v"
                            Placeholder="55123456" Autocomplete="tel-national"
                            HelperText="Ingresa 8 dígitos; +502 se agrega automáticamente."
                            ForceTouched='@TieneError("Telefono")' ValidationCycle="ValidationCycle" />

        <ValidatedTextInput Id="dp-direccion" Label="Dirección" Kind="FormFieldKind.Text"
                            Value="@Modelo.Direccion" ValueChanged="v => Modelo.Direccion = v"
                            Placeholder="Ej. 6a avenida 10-25, zona 1, Guatemala" Autocomplete="street-address" MaxLength="250"
                            HelperText="Incluye zona, municipio o referencias útiles si aplica."
                            ForceTouched='@TieneError("Direccion")' ValidationCycle="ValidationCycle" CssClass="sm:col-span-2" />
    }

    @if (Muestra(SeccionFormulario.Salud))
    {
        <ValidatedTextArea Id="dp-alergias" Label="Alergias conocidas"
                           Value="@Modelo.Alergias" ValueChanged="v => Modelo.Alergias = v"
                           Placeholder="Ej. Penicilina, mariscos o ninguna conocida"
                           HelperText="Este dato lo revisa el personal clínico antes de atenderte."
                           MaxLength="500" Rows="2" ShowCounter="true"
                           ForceTouched='@TieneError("Alergias")' ValidationCycle="ValidationCycle" CssClass="sm:col-span-2" />

        <ValidatedTextInput Id="dp-contacto-nombre" Label="Contacto de emergencia" Kind="FormFieldKind.Name"
                            Value="@Modelo.ContactoEmergenciaNombre" ValueChanged="v => Modelo.ContactoEmergenciaNombre = v"
                            Placeholder="Ej. Juan Pérez" Autocomplete="name" MaxLength="150"
                            ForceTouched='@TieneError("ContactoEmergenciaNombre")' ValidationCycle="ValidationCycle" />

        <ValidatedTextInput Id="dp-contacto-telefono" Label="Teléfono de emergencia" Kind="FormFieldKind.GuatemalaPhone"
                            Value="@Modelo.ContactoEmergenciaTelefono" ValueChanged="v => Modelo.ContactoEmergenciaTelefono = v"
                            Placeholder="55123456" Autocomplete="tel-national"
                            HelperText="8 dígitos; +502 se agrega automáticamente."
                            ForceTouched='@TieneError("ContactoEmergenciaTelefono")' ValidationCycle="ValidationCycle" />
    }
</div>

@code {
    [Parameter, EditorRequired] public ModeloDatosPaciente Modelo { get; set; } = new();
    [Parameter] public IReadOnlyDictionary<string, string> Errores { get; set; } = new Dictionary<string, string>();
    [Parameter] public bool MostrarCredenciales { get; set; }
    [Parameter] public bool DocumentoSoloLectura { get; set; }
    [Parameter] public SeccionFormulario Seccion { get; set; } = SeccionFormulario.Completo;
    [Parameter] public int ValidationCycle { get; set; }

    private static readonly string HoyIso = DateTime.Today.ToString("yyyy-MM-dd");
    private const string ClaseBase = "mt-1 w-full rounded-control border bg-surface px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2";

    private bool Muestra(SeccionFormulario cual) => Seccion == SeccionFormulario.Completo || Seccion == cual;
    private bool TieneError(string campo) => Errores.ContainsKey(campo);
    private string? Error(string campo) => Errores.TryGetValue(campo, out var mensaje) ? mensaje : null;
    private string ClaseInputNativo(string campo) => TieneError(campo)
        ? $"{ClaseBase} border-state-rechazada focus:border-state-rechazada focus:ring-state-rechazada/20"
        : $"{ClaseBase} border-border focus:border-brand-500 focus:ring-brand-100";
}
