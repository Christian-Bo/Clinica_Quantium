@* Muestra en vivo qué reglas de la contraseña ya se cumplen. Decirle al
   usuario lo que le falta MIENTRAS escribe evita el rechazo al enviar. *@

@if (!string.IsNullOrEmpty(Password))
{
    <div class="mt-2">
        <div class="flex items-center gap-2">
            <div class="h-1.5 flex-1 overflow-hidden rounded-pill bg-surface-muted">
                <div class="@ClaseBarra" style="width: @(Porcentaje)%"></div>
            </div>
            <span class="@ClaseEtiqueta">@Etiqueta</span>
        </div>

        <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
            @foreach (var regla in Reglas)
            {
                <li class="@ClaseRegla(regla.Cumplida)">
                    <Icon Name="@(regla.Cumplida ? "check" : "x")" Size="12" />
                    @regla.Texto
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public string Password { get; set; } = string.Empty;

    private sealed record Regla(string Texto, bool Cumplida);

    private List<Regla> Reglas =>
    [
        new($"{ModeloDatosPaciente.PasswordMinLength} caracteres", Password.Length >= ModeloDatosPaciente.PasswordMinLength),
        new("mayúscula", Password.Any(char.IsUpper)),
        new("minúscula", Password.Any(char.IsLower)),
        new("número", Password.Any(char.IsDigit)),
        new("símbolo", Password.Any(caracter => !char.IsLetterOrDigit(caracter)))
    ];

    private int Cumplidas => Reglas.Count(regla => regla.Cumplida);

    private int Porcentaje => (int)Math.Round(Cumplidas / 5d * 100);

    private string Etiqueta => Cumplidas switch
    {
        5 => "Lista",
        >= 3 => "Casi",
        _ => "Débil"
    };

    private string ClaseBarra
    {
        get
        {
            const string Base = "h-full rounded-pill transition-all duration-300";
            return Cumplidas switch
            {
                5 => $"{Base} bg-state-atendida",
                >= 3 => $"{Base} bg-state-solicitada",
                _ => $"{Base} bg-state-rechazada"
            };
        }
    }

    private string ClaseEtiqueta => Cumplidas switch
    {
        5 => "text-xs font-semibold text-state-atendida",
        >= 3 => "text-xs font-semibold text-state-solicitada",
        _ => "text-xs font-semibold text-state-rechazada"
    };

    private static string ClaseRegla(bool cumplida) => cumplida
        ? "inline-flex items-center gap-1 text-xs text-state-atendida"
        : "inline-flex items-center gap-1 text-xs text-ink-muted";
}
