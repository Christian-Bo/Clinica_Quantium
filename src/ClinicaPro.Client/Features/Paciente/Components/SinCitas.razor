@* Estado vacío del portal. Es lo primero que ve un paciente recién registrado,
   así que en vez de un icono gris lleva un dibujo propio en los colores de la
   marca: un calendario despejado con una hoja. *@

<div class="flex flex-col items-center justify-center px-4 py-10 text-center">

    <svg width="132" height="112" viewBox="0 0 132 112" fill="none" role="img"
         aria-label="Calendario sin citas" class="mb-5">
        <!-- Halo -->
        <ellipse cx="66" cy="98" rx="44" ry="7" fill="currentColor" class="text-brand-100" />

        <!-- Hoja del calendario -->
        <rect x="27" y="20" width="78" height="70" rx="10"
              fill="currentColor" class="text-surface" stroke="currentColor" stroke-width="2.5"
              stroke-linejoin="round" />
        <rect x="27" y="20" width="78" height="18" rx="10"
              fill="currentColor" class="text-brand-500" />
        <rect x="27" y="30" width="78" height="8" fill="currentColor" class="text-brand-500" />

        <!-- Anillas -->
        <path d="M46 14v12M86 14v12" stroke="currentColor" class="text-brand-700"
              stroke-width="4.5" stroke-linecap="round" />

        <!-- Casillas vacías -->
        <g class="text-brand-100" fill="currentColor">
            <rect x="38" y="49" width="13" height="10" rx="2.5" />
            <rect x="57" y="49" width="13" height="10" rx="2.5" />
            <rect x="76" y="49" width="13" height="10" rx="2.5" />
            <rect x="38" y="65" width="13" height="10" rx="2.5" />
            <rect x="76" y="65" width="13" height="10" rx="2.5" />
        </g>

        <!-- Hoja de la marca, en la casilla libre del centro -->
        <g transform="translate(55 62)">
            <path d="M2 14c6 0 10-4 11.5-11.5C6 3 2 7 2 14Z"
                  fill="currentColor" class="text-brand-500" />
            <path d="M3.5 12.5c2-2 4-4 8-8.5" stroke="currentColor" class="text-surface"
                  stroke-width="1.4" stroke-linecap="round" fill="none" />
        </g>
    </svg>

    <p class="text-sm font-semibold text-ink">@Titulo</p>

    @if (!string.IsNullOrEmpty(Descripcion))
    {
        <p class="mt-1.5 max-w-sm text-sm leading-relaxed text-ink-muted">@Descripcion</p>
    }

    @if (Accion is not null)
    {
        <div class="mt-5">@Accion</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string? Descripcion { get; set; }
    [Parameter] public RenderFragment? Accion { get; set; }
}
