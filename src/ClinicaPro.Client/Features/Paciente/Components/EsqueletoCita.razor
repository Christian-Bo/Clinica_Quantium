@* Esqueleto con la forma real de TarjetaCita. Barras genéricas hacen que al
   llegar los datos la pantalla dé un salto; imitando la forma, la transición
   se siente continua. *@

@for (var i = 0; i < Cantidad; i++)
{
    <div class="animate-pulse rounded-card border border-border bg-surface p-4 shadow-card" aria-hidden="true">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1 space-y-2">
                <div class="h-4 w-40 rounded bg-surface-muted"></div>
                <div class="h-3.5 w-28 rounded bg-surface-muted"></div>
            </div>
            <div class="h-6 w-24 rounded-pill bg-surface-muted"></div>
        </div>

        <div class="mt-3 h-6 w-32 rounded-pill bg-surface-muted"></div>

        <div class="mt-3 flex gap-5">
            <div class="h-4 w-36 rounded bg-surface-muted"></div>
            <div class="h-4 w-24 rounded bg-surface-muted"></div>
        </div>

        <div class="mt-3 border-t border-border pt-3">
            <div class="h-4 w-3/4 rounded bg-surface-muted"></div>
        </div>

        <div class="mt-4 flex gap-2">
            <div class="h-8 w-36 rounded-control bg-surface-muted"></div>
            <div class="h-8 w-28 rounded-control bg-surface-muted"></div>
        </div>
    </div>
}

@code {
    [Parameter] public int Cantidad { get; set; } = 2;
}
