@page "/portal/notificaciones"
@attribute [Authorize(Roles = Roles.Paciente)]
@layout PacienteLayout
@inject NotificacionesPacienteApiService NotificacionesApi

<PageTitle>Mis avisos · Clínica Pro</PageTitle>

<h1 class="text-xl font-semibold text-ink">Mis avisos</h1>
<p class="mt-1 text-sm text-ink-muted">
    Los mensajes que la clínica te envió sobre tus citas.
</p>

<div class="mt-6 max-w-3xl">
    @if (cargando)
    {
        <Skeleton Filas="3" HeightClass="h-24" />
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <Card>
            <EmptyState IconName="alert-triangle" Title="No pudimos cargar tus avisos"
                        Description="@error">
                <Action>
                    <Button Variant="ButtonVariant.Secondary" OnClick="Cargar">Reintentar</Button>
                </Action>
            </EmptyState>
        </Card>
    }
    else if (avisos.Count == 0)
    {
        <Card>
            <EmptyState IconName="bell" Title="Todavía no tienes avisos"
                        Description="Cuando la clínica programe, confirme o reprograme una cita tuya, el aviso aparecerá aquí." />
        </Card>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var aviso in avisos)
            {
                <div class="rounded-card border border-border bg-surface p-4 shadow-card">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-ink">@Titulo(aviso)</p>
                            <p class="mt-0.5 text-xs text-ink-muted">
                                @aviso.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                · enviado por @aviso.Canal.ToLowerInvariant()
                            </p>
                        </div>
                        <span class="@ClaseEstado(aviso.Estado)">@aviso.Estado</span>
                    </div>

                    <p class="mt-3 whitespace-pre-line border-t border-border pt-3 text-sm text-ink-muted">
                        @aviso.Contenido
                    </p>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<NotificacionDto> avisos = [];
    private bool cargando = true;
    private string? error;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        cargando = true;
        error = null;

        var resultado = await NotificacionesApi.ListarMisNotificacionesAsync();
        if (!resultado.Exito)
        {
            error = resultado.Error;
            cargando = false;
            return;
        }

        avisos = [.. resultado.Valor!.OrderByDescending(aviso => aviso.CreatedAtUtc)];
        cargando = false;
    }

    private static string Titulo(NotificacionDto aviso)
        => string.IsNullOrWhiteSpace(aviso.Asunto) ? aviso.Tipo : aviso.Asunto;

    private static string ClaseEstado(string estado)
    {
        const string Base = "inline-flex items-center whitespace-nowrap rounded-pill px-2.5 py-1 text-xs font-medium";

        return estado.ToLowerInvariant() switch
        {
            "enviada" or "enviado" => $"{Base} bg-state-atendida/10 text-state-atendida",
            "pendiente" => $"{Base} bg-state-solicitada/10 text-state-solicitada",
            "fallida" or "fallido" => $"{Base} bg-state-rechazada/10 text-state-rechazada",
            _ => $"{Base} bg-surface-muted text-ink-muted"
        };
    }
}
