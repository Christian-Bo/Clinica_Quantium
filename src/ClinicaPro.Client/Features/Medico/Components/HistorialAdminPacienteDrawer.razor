@inject CitasApiService CitasApi

<Drawer IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Title="Historial del paciente" CloseOnBackdrop="false">
    <Body>
        @if (cargando)
        {
            <Skeleton Filas="5" />
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="rounded-control border border-state-rechazada/20 bg-state-rechazada/5 p-3">
                <p class="text-sm text-state-rechazada">@error</p>
                <p class="mt-1 text-xs text-ink-muted">Se reintentará automáticamente.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                <div class="rounded-control bg-brand-50 p-4">
                    <p class="text-base font-semibold text-ink">@PacienteNombre</p>
                    <p class="mt-1 text-xs text-ink-muted">Vista administrativa del historial de citas. El acceso clínico detallado continúa restringido al médico correspondiente.</p>
                </div>

                @if (citas.Count == 0)
                {
                    <EmptyState IconName="calendar" Title="Sin citas registradas" Description="Este paciente todavía no tiene historial de citas disponible." />
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var cita in citas.OrderByDescending(x => x.FechaHoraInicio))
                        {
                            <div class="rounded-control border border-border bg-surface p-3">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-medium text-ink">@cita.MedicoNombre</p>
                                        <p class="mt-0.5 text-xs text-ink-muted">@cita.FechaHoraInicio.ToString("dd/MM/yyyy · HH:mm")</p>
                                    </div>
                                    <CitaStatusBadge Estado="@cita.Estado" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(cita.MotivoConsulta))
                                {
                                    <p class="mt-2 text-xs text-ink-muted">@cita.MotivoConsulta</p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </Body>
</Drawer>

<AutoRefresh Enabled="@(!string.IsNullOrWhiteSpace(error) && IsOpen)" IntervalSeconds="12" OnRefresh="CargarAsync" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Guid? PacienteId { get; set; }
    [Parameter] public string PacienteNombre { get; set; } = "Paciente";

    private List<CitaDto> citas = [];
    private bool cargando;
    private string? error;
    private Guid? pacienteAnterior;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && PacienteId.HasValue && pacienteAnterior != PacienteId)
        {
            pacienteAnterior = PacienteId;
            await CargarAsync();
        }
        else if (!IsOpen)
        {
            pacienteAnterior = null;
        }
    }

    private async Task CargarAsync()
    {
        if (!PacienteId.HasValue)
        {
            return;
        }

        cargando = citas.Count == 0;
        try
        {
            citas = (await CitasApi.ListarPorPacienteAsync(PacienteId.Value)).ToList();
            error = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            error = MensajeUsuario.Limpiar(ex.Message, "No pudimos cargar el historial del paciente.");
        }
        finally
        {
            cargando = false;
        }
    }
}
