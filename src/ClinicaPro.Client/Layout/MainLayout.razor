@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
            <a href="/" class="text-lg font-bold tracking-tight">Clínica Pro</a>
            <nav class="flex items-center gap-5 text-sm font-medium">
                <NavLink href="/" Match="NavLinkMatch.All" class="text-slate-600 hover:text-slate-950">Inicio</NavLink>
                <NavLink href="/solicitar-cita" class="text-slate-600 hover:text-slate-950">Solicitar cita</NavLink>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        @Body
    </main>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-5 text-sm text-slate-500 sm:px-6 lg:px-8">
            Base técnica de Clínica Pro · Análisis de Sistemas II
        </div>
    </footer>
</div>
