@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<div class="flex h-full flex-col">
    <div class="flex items-center gap-2 px-5 py-5">
        <div class="flex h-9 w-9 items-center justify-center rounded-control bg-brand-500">
            <Icon Name="leaf" Size="18" />
        </div>
        <div>
            <p class="text-sm font-semibold leading-tight">Clínica Pro</p>
            <p class="text-xs text-white/50">Panel de Secretaría</p>
        </div>
    </div>

    <NavMenu />

    <div class="mt-auto border-t border-white/10 px-5 py-4">
        <AuthorizeView>
            <Authorized>
                <p class="truncate text-sm font-medium">@context.User.Identity?.Name</p>
                <p class="text-xs text-white/50">Secretaria</p>
            </Authorized>
        </AuthorizeView>
        <button type="button" class="mt-3 flex items-center gap-2 text-sm text-white/70 hover:text-white"
                @onclick="CerrarSesion">
            <Icon Name="log-out" Size="16" />
            Cerrar sesión
        </button>
    </div>
</div>

@code {
    private async Task CerrarSesion()
    {
        await AuthApi.CerrarSesionAsync();
        Navigation.NavigateTo("/login", replace: true);
    }
}
