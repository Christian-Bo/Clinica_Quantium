{
  "name": "clinicapro-client-assets",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:ts",
    "build:css": "npx @tailwindcss/cli -i ./Styles/input.css -o ./wwwroot/css/app.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./Styles/input.css -o ./wwwroot/css/app.css --watch",
    "build:ts": "tsc -p tsconfig.json",
    "watch:ts": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
