@page "/cambiar-contrasena"
@attribute [Authorize]
@layout Layout.EmptyLayout
@inject AuthApiService AuthApi
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation

<PageTitle>Cambiar contraseña · Clínica Pro</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-md rounded-card border border-border bg-surface p-8 shadow-card">
        <div class="mb-6">
            <div class="mb-3 flex h-11 w-11 items-center justify-center rounded-control bg-brand-100 text-brand-700">
                <Icon Name="key" Size="21" />
            </div>
            <h1 class="text-xl font-semibold text-ink">Cambiar contraseña</h1>
            <p class="mt-1 text-sm text-ink-muted">
                @(cambioObligatorio
                    ? "Por seguridad debes reemplazar la contraseña temporal antes de continuar."
                    : "Actualiza tu contraseña de acceso a Clínica Pro.")
            </p>
        </div>

        <EditForm Model="modelo" OnValidSubmit="GuardarAsync">
            <div class="space-y-4">
                <PasswordField Id="pwd-actual" Label="Contraseña actual" Value="@modelo.Actual" ValueChanged="v => modelo.Actual = v"
                               ValidatePolicy="false" Placeholder="Ingresa tu contraseña actual" Autocomplete="current-password"
                               ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <PasswordField Id="pwd-nueva" Label="Nueva contraseña" Value="@modelo.Nueva" ValueChanged="v => modelo.Nueva = v"
                               Placeholder="Ej. Nueva@2026" Autocomplete="new-password" ShowRules="true"
                               ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                <PasswordField Id="pwd-confirmar" Label="Confirmar nueva contraseña" Value="@modelo.Confirmacion" ValueChanged="v => modelo.Confirmacion = v"
                               ValidatePolicy="false" ValidateMatch="true" MatchValue="@modelo.Nueva"
                               Placeholder="Repite la contraseña nueva" Autocomplete="new-password"
                               ForceTouched="mostrarValidaciones" ValidationCycle="cicloValidacion" />

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="rounded-control bg-state-rechazada/10 px-3 py-2 text-sm text-state-rechazada">@error</p>
                }

                <div class="flex flex-col gap-2 pt-3 sm:flex-row justify-end">
                    @if (!cambioObligatorio)
                    {
                        <Button Variant="ButtonVariant.Secondary" Disabled="guardando" OnClick="Volver">Volver</Button>
                    }
                    <Button Type="submit" Variant="ButtonVariant.Primary" IconName="check" Loading="guardando">
                        Guardar contraseña
                    </Button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly ModeloCambio modelo = new();
    private bool cambioObligatorio;
    private bool guardando;
    private string? error;
    private bool mostrarValidaciones;
    private int cicloValidacion = 1;

    protected override async Task OnInitializedAsync()
    {
        var sesion = await TokenStorage.ObtenerAsync();
        if (sesion is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }
        var actual = await AuthApi.ObtenerUsuarioActualSeguroAsync();
        cambioObligatorio = actual.Exito && actual.Valor is not null ? actual.Valor.MustChangePassword : sesion.MustChangePassword;
    }

    private async Task GuardarAsync()
    {
        if (guardando) return;
        error = null;
        mostrarValidaciones = true;

        if (string.IsNullOrWhiteSpace(modelo.Actual) || !FormValidation.IsPasswordValid(modelo.Nueva)
            || !string.Equals(modelo.Nueva, modelo.Confirmacion, StringComparison.Ordinal)) return;

        if (string.Equals(modelo.Actual, modelo.Nueva, StringComparison.Ordinal))
        {
            error = "La nueva contraseña debe ser diferente a la contraseña actual.";
            return;
        }

        guardando = true;
        try
        {
            var resultado = await AuthApi.CambiarContrasenaAsync(modelo.Actual, modelo.Nueva);
            if (!resultado.Exito || resultado.Valor is null)
            {
                error = resultado.Error ?? "No fue posible cambiar la contraseña.";
                return;
            }
            Navigation.NavigateTo(RoleRoutes.Inicio(resultado.Valor.Roles), replace: true);
        }
        finally { guardando = false; }
    }

    private void Volver()
    {
        var sesion = TokenStorage.Actual;
        Navigation.NavigateTo(sesion is null ? "/login" : RoleRoutes.Inicio(sesion.Roles));
    }

    private sealed class ModeloCambio
    {
        public string Actual { get; set; } = string.Empty;
        public string Nueva { get; set; } = string.Empty;
        public string Confirmacion { get; set; } = string.Empty;
    }
}
