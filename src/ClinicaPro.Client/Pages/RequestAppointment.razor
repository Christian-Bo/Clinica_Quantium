@page "/solicitar-cita"
@inject ClinicaProApiClient Api

<PageTitle>Solicitar cita</PageTitle>

<div class="mx-auto max-w-2xl">
    <div class="mb-7">
        <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">Portal del paciente</p>
        <h1 class="mt-2 text-3xl font-bold">Solicitar una cita</h1>
        <p class="mt-2 text-slate-600">La solicitud quedará pendiente de revisión administrativa.</p>
    </div>

    <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" />

        <div class="grid gap-6 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label class="mb-2 block text-sm font-medium" for="specialty">Especialidad</label>
                <InputSelect id="specialty" @bind-Value="_model.SpecialtyId" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5">
                    <option value="@Guid.Empty">Seleccione una especialidad</option>
                    @foreach (var specialty in _specialties)
                    {
                        <option value="@specialty.Id">@specialty.Name</option>
                    }
                </InputSelect>
            </div>

            <div>
                <label class="mb-2 block text-sm font-medium" for="date">Fecha</label>
                <InputDate id="date" @bind-Value="_model.Date" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5" />
            </div>

            <div>
                <label class="mb-2 block text-sm font-medium" for="time">Hora</label>
                <InputText id="time" type="time" @bind-Value="_model.TimeText" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5" />
            </div>

            <div class="sm:col-span-2">
                <label class="mb-2 block text-sm font-medium" for="reason">Motivo de consulta</label>
                <InputTextArea id="reason" @bind-Value="_model.Reason" rows="4" maxlength="200" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5" />
            </div>
        </div>

        <button type="submit" disabled="@_submitting" class="mt-7 w-full rounded-lg bg-slate-950 px-5 py-3 font-semibold text-white hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60">
            @(_submitting ? "Enviando..." : "Enviar solicitud")
        </button>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                @_message
            </div>
        }
    </EditForm>
</div>

@code {
    private readonly AppointmentFormModel _model = new();
    private IReadOnlyCollection<SpecialtyResponse> _specialties = Array.Empty<SpecialtyResponse>();
    private bool _submitting;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _specialties = await Api.GetSpecialtiesAsync();
        _model.Date = DateTime.Today.AddDays(1);
    }

    private async Task SubmitAsync()
    {
        _message = null;

        if (_model.SpecialtyId == Guid.Empty)
        {
            _message = "Seleccione una especialidad.";
            return;
        }

        if (!TimeOnly.TryParse(_model.TimeText, out var time))
        {
            _message = "Ingrese una hora válida.";
            return;
        }

        _submitting = true;
        try
        {
            var request = new RequestAppointmentRequest
            {
                PatientId = Guid.Parse("11111111-1111-1111-1111-111111111111"),
                SpecialtyId = _model.SpecialtyId,
                Date = DateOnly.FromDateTime(_model.Date),
                StartTime = time,
                Reason = _model.Reason
            };

            var result = await Api.RequestAppointmentAsync(request);
            _message = $"Solicitud registrada con estado {result.Status}. Código: {result.Id}.";
            _model.Reason = string.Empty;
        }
        catch (Exception exception)
        {
            _message = exception.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class AppointmentFormModel
    {
        public Guid SpecialtyId { get; set; }
        public DateTime Date { get; set; }
        public string TimeText { get; set; } = "08:00";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El motivo es obligatorio.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, MinimumLength = 5, ErrorMessage = "El motivo debe tener entre 5 y 200 caracteres.")]
        public string Reason { get; set; } = string.Empty;
    }
}
