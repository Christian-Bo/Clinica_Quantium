@page "/cambiar-password"
@attribute [Authorize]
@layout Layout.EmptyLayout
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

@* La API marca MustChangePassword cuando la cuenta se creó desde el mostrador
   con una contraseña temporal. Sin esta pantalla, ese usuario entraría con la
   temporal y nadie le pediría cambiarla nunca. *@

<PageTitle>Cambiar contraseña · Clínica Pro</PageTitle>

<AuthShell Titulo="Cambia tu contraseña"
           Subtitulo="Estás usando la contraseña temporal que te dio la clínica. Elige una propia para continuar.">

    <div class="rounded-card border border-border bg-surface p-7 shadow-card">
        <EditForm Model="modelo" OnValidSubmit="Guardar">
            <div class="space-y-5">
                <div>
                    <label class="text-sm font-medium text-ink" for="cp-actual">Contraseña temporal</label>
                    <input id="cp-actual" type="password" autocomplete="current-password" required
                           class="@ClaseInput" @bind="modelo.Actual" @bind:event="oninput" />
                </div>
                <div>
                    <label class="text-sm font-medium text-ink" for="cp-nueva">Contraseña nueva</label>
                    <input id="cp-nueva" type="password" autocomplete="new-password" required
                           class="@ClaseInput" @bind="modelo.Nueva" @bind:event="oninput" />
                    <p class="mt-1.5 text-xs text-ink-muted">@AyudaPassword</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-ink" for="cp-confirmacion">Repetir contraseña nueva</label>
                    <input id="cp-confirmacion" type="password" autocomplete="new-password" required
                           class="@ClaseInput" @bind="modelo.Confirmacion" @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div role="alert" class="flex items-start gap-2.5 rounded-control border border-state-rechazada/25 bg-state-rechazada/10 px-3.5 py-3">
                        <span class="mt-0.5 text-state-rechazada"><Icon Name="alert-triangle" Size="17" /></span>
                        <p class="text-sm leading-relaxed text-state-rechazada">@error</p>
                    </div>
                }

                <Button Type="submit" Variant="ButtonVariant.Primary" FullWidth="true" Loading="guardando">
                    Guardar y continuar
                </Button>
            </div>
        </EditForm>
    </div>

</AuthShell>

@code {
    private const string ClaseInput =
        "mt-1.5 w-full rounded-control border border-border bg-surface px-3 py-2.5 text-sm text-ink transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100";

    private static readonly string AyudaPassword =
        $"Mínimo {ModeloDatosPaciente.PasswordMinLength} caracteres, con mayúscula, minúscula, número y un símbolo.";

    private readonly ModeloCambio modelo = new();
    private string? error;
    private bool guardando;

    private async Task Guardar()
    {
        error = null;

        var faltantes = ModeloDatosPaciente.ReglasPasswordFaltantes(modelo.Nueva);
        if (faltantes.Count > 0)
        {
            error = "La contraseña nueva necesita " + string.Join(", ", faltantes) + ".";
            return;
        }

        if (modelo.Nueva != modelo.Confirmacion)
        {
            error = "Las contraseñas nuevas no coinciden.";
            return;
        }

        guardando = true;
        var resultado = await AuthApi.CambiarPasswordAsync(modelo.Actual, modelo.Nueva);
        guardando = false;

        if (resultado.Exito && resultado.Valor is not null)
        {
            Navigation.NavigateTo(RutasPorRol.InicioPara(resultado.Valor.Roles), replace: true);
            return;
        }

        error = resultado.Error ?? "No fue posible cambiar la contraseña.";
    }

    private sealed class ModeloCambio
    {
        public string Actual { get; set; } = string.Empty;
        public string Nueva { get; set; } = string.Empty;
        public string Confirmacion { get; set; } = string.Empty;
    }
}
