@page "/"
@inject ClinicaProApiClient Api

<PageTitle>Clínica Pro</PageTitle>

<section class="grid items-center gap-10 lg:grid-cols-2">
    <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">Gestión de citas</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">El proceso clínico comienza con una solicitud ordenada.</h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
            El paciente solicita un horario, el sistema valida disponibilidad y la secretaría continúa el proceso administrativo.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/solicitar-cita" class="rounded-lg bg-slate-950 px-5 py-3 font-semibold text-white hover:bg-slate-800">
                Solicitar una cita
            </a>
            <button class="rounded-lg border border-slate-300 bg-white px-5 py-3 font-semibold hover:bg-slate-100" @onclick="CheckApiAsync">
                Verificar backend
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_apiStatus))
        {
            <p class="mt-4 text-sm text-slate-600">@_apiStatus</p>
        }
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
        <h2 class="text-xl font-semibold">Reglas incluidas en la base</h2>
        <ul class="mt-5 space-y-4 text-slate-600">
            <li><strong class="text-slate-900">1.</strong> La fecha y hora deben ser futuras.</li>
            <li><strong class="text-slate-900">2.</strong> El horario debe pertenecer a la jornada del médico.</li>
            <li><strong class="text-slate-900">3.</strong> Una solicitud activa bloquea el intervalo para evitar doble reserva.</li>
            <li><strong class="text-slate-900">4.</strong> La solicitud inicia en estado <em>Solicitada</em>.</li>
        </ul>
    </div>
</section>

@code {
    private string? _apiStatus;

    private async Task CheckApiAsync()
    {
        try
        {
            var health = await Api.GetHealthAsync();
            _apiStatus = $"Backend disponible: {health}";
        }
        catch (Exception exception)
        {
            _apiStatus = $"No fue posible conectar con el backend: {exception.Message}";
        }
    }
}
