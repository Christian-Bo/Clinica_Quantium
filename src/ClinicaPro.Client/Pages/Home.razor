@page "/"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="flex min-h-screen items-center justify-center bg-surface-muted text-sm text-ink-muted">
    Cargando Clínica Pro...
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();
        var destino = estado.User.Identity?.IsAuthenticated == true ? "/dashboard" : "/login";
        Navigation.NavigateTo(destino, replace: true);
    }
}
