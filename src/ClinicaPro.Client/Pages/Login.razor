@page "/login"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · Clínica Pro</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm rounded-card bg-surface p-8 shadow-card">
        <div class="mb-6 text-center">
            <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-control bg-brand-500 text-white">
                <Icon Name="leaf" Size="24" />
            </div>
            <h1 class="text-lg font-semibold text-ink">Clínica Pro</h1>
            <p class="text-sm text-ink-muted">Ingresa con tu cuenta de personal</p>
        </div>

        <EditForm Model="modelo" OnValidSubmit="Ingresar">
            <div class="space-y-4">
                <div>
                    <label class="text-sm font-medium text-ink" for="login-email">Correo electrónico</label>
                    <input id="login-email" type="email" required autocomplete="username"
                           class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                           @bind="modelo.Email" @bind:event="oninput" />
                </div>
                <div>
                    <label class="text-sm font-medium text-ink" for="login-password">Contraseña</label>
                    <input id="login-password" type="password" required autocomplete="current-password"
                           class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                           @bind="modelo.Password" @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="rounded-control bg-state-rechazada/10 px-3 py-2 text-sm text-state-rechazada">@error</p>
                }

                <Button Type="submit" Variant="ButtonVariant.Primary" FullWidth="true" Loading="cargando">
                    Ingresar
                </Button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly ModeloLogin modelo = new();
    private string? error;
    private bool cargando;

    private async Task Ingresar()
    {
        error = null;
        cargando = true;

        var resultado = await AuthApi.IniciarSesionAsync(modelo.Email, modelo.Password);
        cargando = false;

        if (resultado.Exito && resultado.Valor is not null)
        {
            var destino = resultado.Valor.MustChangePassword
                ? "/cambiar-contrasena"
                : RoleRoutes.Inicio(resultado.Valor.Roles);
            Navigation.NavigateTo(destino, replace: true);
        }
        else
        {
            error = resultado.Error;
        }
    }

    private sealed class ModeloLogin
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
